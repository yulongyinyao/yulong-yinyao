---
import { site, withBase } from '../consts';

interface Props {
  title?: string;
  subtitle?: string;
  eyebrow?: string;
}

const {
  title = site.name,
  subtitle = site.description,
  eyebrow = '私人存档 · 文章与插画',
} = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-white/40 dark:border-white/10">
  <img
    src={withBase(site.heroImage)}
    alt=""
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[#1b1730]/55 via-[#2a2140]/45 to-cream/95 dark:to-[#0f0d18]"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-cream to-transparent dark:from-[#0f0d18]"></div>

  <div class="mx-auto flex min-h-[24rem] max-w-[88rem] flex-col items-center justify-center px-4 py-20 text-center sm:min-h-[28rem] sm:px-6 lg:min-h-[30rem] lg:px-8">
    <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/15 px-3.5 py-1.5 text-[0.68rem] font-medium uppercase tracking-[0.22em] text-white/90 backdrop-blur-md">
      <span class="h-1.5 w-1.5 rounded-full bg-amber-300"></span>
      {eyebrow}
    </p>

    <h1 class="font-display text-4xl font-semibold tracking-tight text-white drop-shadow-[0_3px_18px_rgba(25,15,45,0.45)] sm:text-6xl lg:text-7xl">
      {title}
    </h1>

    <p class="mt-4 max-w-2xl text-balance text-sm leading-7 text-white/85 sm:text-base">
      {subtitle}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={withBase('/posts/')}
        class="inline-flex items-center gap-2 rounded-full bg-white/95 px-5 py-2.5 text-sm font-semibold text-ink shadow-lg shadow-black/10 transition hover:-translate-y-0.5 hover:bg-white"
      >
        读文章
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a
        href={withBase('/illustrations/')}
        class="inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/10 px-5 py-2.5 text-sm font-semibold text-white backdrop-blur-md transition hover:-translate-y-0.5 hover:bg-white/20"
      >
        看插画
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 5h16v14H4zM4 15l4-4 4 4 2-2 6 6" stroke-linejoin="round"></path>
          <circle cx="9" cy="9" r="1.4"></circle>
        </svg>
      </a>
    </div>

    <p class="mt-6 text-[0.68rem] tracking-wide text-white/55">
      本站为私人站点，已禁止搜索引擎抓取与收录
    </p>
  </div>
</section>
