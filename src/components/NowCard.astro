---
import { site } from '../consts';

const nowPlaying =
  (site as typeof site & { nowPlaying?: { title?: string; artist?: string; url?: string } }).nowPlaying ??
  {};
const hasMusic = Boolean(nowPlaying.title);
---

<section class="card p-5" data-pagefind-ignore>
  <div class="flex items-center justify-between">
    <h2 class="font-display text-base font-semibold text-ink dark:text-white">此刻</h2>
    <span class="flex items-center gap-1.5 text-[0.65rem] text-slate-400 dark:text-slate-500">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
      北京
    </span>
  </div>

  <div class="mt-3 flex items-end gap-3" data-weather>
    <span class="text-2xl" data-weather-icon aria-hidden="true">·</span>
    <div>
      <p class="font-display text-3xl font-semibold leading-none text-ink dark:text-white">
        <span data-weather-temp>--</span><span class="text-base font-normal text-slate-400">°</span>
      </p>
      <p class="mt-1 text-[0.68rem] text-slate-500 dark:text-slate-400" data-weather-label>正在读取天气…</p>
    </div>
  </div>

  {
    hasMusic && (
      <a
        href={nowPlaying.url || '#'}
        target={nowPlaying.url ? '_blank' : undefined}
        rel={nowPlaying.url ? 'noopener noreferrer' : undefined}
        class="mt-4 flex items-center gap-3 rounded-xl border border-white/60 bg-white/40 px-3 py-2.5 transition hover:border-rose-200 dark:border-white/10 dark:bg-white/5 dark:hover:border-rose-400/30"
      >
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-rose-100 text-rose-500 dark:bg-rose-400/15 dark:text-rose-300">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M9 18V5l10-2v13"></path>
            <circle cx="6.5" cy="18" r="2.5"></circle>
            <circle cx="16.5" cy="16" r="2.5"></circle>
          </svg>
        </span>
        <span class="min-w-0">
          <span class="block truncate text-xs font-medium text-ink dark:text-white">{nowPlaying.title}</span>
          <span class="block truncate text-[0.65rem] text-slate-400">{nowPlaying.artist || '正在听'}</span>
        </span>
      </a>
    )
  }
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-weather]').forEach((weather) => {
    const temp = weather.querySelector('[data-weather-temp]');
    const label = weather.querySelector('[data-weather-label]');
    const icon = weather.querySelector('[data-weather-icon]');

    const descriptions: Record<number, string> = {
      0: '晴',
      1: '大致晴朗',
      2: '局部多云',
      3: '阴',
      45: '雾',
      48: '雾凇',
      51: '小毛毛雨',
      53: '毛毛雨',
      55: '大毛毛雨',
      61: '小雨',
      63: '中雨',
      65: '大雨',
      71: '小雪',
      73: '中雪',
      75: '大雪',
      80: '阵雨',
      81: '中等阵雨',
      82: '强阵雨',
      95: '雷雨',
    };
    const glyphs: Record<number, string> = {
      0: '☀', 1: '☀', 2: '⛅', 3: '☁', 45: '≋', 48: '≋',
      51: '☂', 53: '☂', 55: '☂', 61: '☂', 63: '☂', 65: '☂',
      71: '❄', 73: '❄', 75: '❄', 80: '☂', 81: '☂', 82: '☂', 95: '⚡',
    };

    fetch(
      'https://api.open-meteo.com/v1/forecast?latitude=39.9042&longitude=116.4074&current=temperature_2m,weather_code&timezone=Asia%2FShanghai',
      { cache: 'no-store' },
    )
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error('weather request failed'))))
      .then((data) => {
        const current = data?.current;
        if (!current) throw new Error('weather data missing');
        if (temp) temp.textContent = String(Math.round(current.temperature_2m));
        if (label) label.textContent = descriptions[current.weather_code] ?? '天气';
        if (icon) icon.textContent = glyphs[current.weather_code] ?? '·';
      })
      .catch(() => {
        if (label) label.textContent = '天气暂时没有回应';
      });
  });
</script>
