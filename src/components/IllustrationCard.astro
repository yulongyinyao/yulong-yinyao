---
import type { CollectionEntry } from 'astro:content';
import { formatDate, illustrationHref, withBase } from '../consts';
import { categoryLabel } from '../data/categories';

interface Props {
  illustration: CollectionEntry<'illustrations'>;
  compact?: boolean;
}

const { illustration, compact = false } = Astro.props;
const href = illustrationHref(illustration.id);
const images = illustration.data.images.map((src) => withBase(src));
const cover = images[0] ?? '';
const description = illustration.data.description?.trim() ?? '';
---

<article
  class="group card overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_60px_-30px_rgba(100,60,120,0.55)]"
  data-filter-item
  data-category={illustration.data.category}
  data-tags={JSON.stringify(illustration.data.tags)}
>
  <a href={href} class="block" aria-label={`查看插画：${illustration.data.title}`}>
    <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-br from-rose-100 via-violet-100 to-slate-100 dark:from-rose-400/15 dark:via-violet-400/10 dark:to-white/5">
      {
        cover ? (
          <img
            src={cover}
            alt={illustration.data.title}
            class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="grid h-full place-items-center">
            <span class="font-display text-4xl text-rose-300/80 dark:text-rose-200/40">y</span>
          </div>
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-[#1b142a]/70 via-transparent to-transparent opacity-80"></div>
      <span class="absolute left-3 top-3 rounded-full border border-white/40 bg-white/80 px-2.5 py-1 text-[0.65rem] font-semibold text-violet-700 backdrop-blur dark:border-white/10 dark:bg-black/40 dark:text-violet-200">
        {categoryLabel('illustration', illustration.data.category)}
      </span>
      {
        images.length > 1 && (
          <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-full border border-white/30 bg-black/30 px-2 py-1 text-[0.65rem] font-medium text-white backdrop-blur">
            <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="14" height="14" rx="2"></rect>
              <path d="M7 3h12a2 2 0 0 1 2 2v12" stroke-linecap="round"></path>
            </svg>
            {images.length}
          </span>
        )
      }
      <div class="absolute inset-x-0 bottom-0 p-5 text-white">
        <p class="text-[0.65rem] tracking-wide text-white/70">{formatDate(illustration.data.date)}</p>
        <h3 class="mt-1 font-display text-xl font-semibold leading-snug tracking-tight drop-shadow-sm">
          {illustration.data.title}
        </h3>
      </div>
    </div>
  </a>

  <div class="p-4">
    {
      description && (
        <p class:list={['text-sm leading-6 text-slate-600 dark:text-slate-300', compact ? 'line-clamp-1' : 'line-clamp-2']}>
          {description}
        </p>
      )
    }
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      {illustration.data.tags.slice(0, compact ? 2 : 3).map((tag) => (
        <a
          href={`${withBase('/illustrations/')}?tag=${encodeURIComponent(tag)}`}
          class="chip border-violet-200/70 bg-violet-50/70 text-violet-700 hover:border-violet-300 hover:bg-violet-100 dark:border-violet-300/20 dark:bg-violet-400/10 dark:text-violet-200 dark:hover:bg-violet-400/20"
        >
          #{tag}
        </a>
      ))}
      <a href={href} class="ml-auto inline-flex items-center gap-1 text-[0.7rem] font-medium text-violet-500 transition hover:gap-1.5 hover:text-violet-600 dark:text-violet-300">
        查看
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
