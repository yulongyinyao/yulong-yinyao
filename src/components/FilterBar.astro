---
interface TagItem {
  name: string;
  count: number;
  href: string;
}

interface Props {
  tags: TagItem[];
  total: number;
  noun?: string;
}

const { tags, total, noun = '篇' } = Astro.props;
---

<section class="card px-5 py-4" aria-label="标签筛选">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="flex items-center gap-2 text-sm font-semibold text-ink dark:text-white">
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-violet-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M20.6 13.4 12 22l-9-9V4h9l8.6 8.6a1 1 0 0 1 0 1.4Z" stroke-linejoin="round"></path>
        <circle cx="8.5" cy="8.5" r="1.4"></circle>
      </svg>
      标签筛选
    </h2>
    <p class="text-[0.65rem] text-slate-400 dark:text-slate-500">
      共 <span data-filter-count class="font-semibold text-slate-600 dark:text-slate-300">{total}</span> {noun}
    </p>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    {
      tags.length > 0 ? (
        tags.map((tag) => (
          <a
            href={tag.href}
            class="chip-muted"
            data-tag-link
            data-filter-link
            data-tag={tag.name}
            aria-pressed="false"
          >
            #{tag.name}
            <span class="text-[0.6rem] opacity-50">{tag.count}</span>
          </a>
        ))
      ) : (
        <span class="text-xs text-slate-500 dark:text-slate-400">还没有标签。</span>
      )
    }
    <button
      type="button"
      class="ml-auto rounded-full px-2.5 py-1 text-[0.68rem] font-medium text-slate-400 transition hover:text-rose-500 dark:text-slate-500 dark:hover:text-rose-300"
      data-filter-clear
      hidden
    >
      清除筛选
    </button>
  </div>
</section>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-item]'));
  const countElement = document.querySelector<HTMLElement>('[data-filter-count]');
  const emptyElement = document.querySelector<HTMLElement>('[data-filter-empty]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-filter-clear]');

  function selectedFilters(): { category: string; tag: string } {
    const params = new URLSearchParams(window.location.search);
    return {
      category: params.get('category') ?? '',
      tag: params.get('tag') ?? '',
    };
  }

  function tagsOf(item: HTMLElement): string[] {
    try {
      const value: unknown = JSON.parse(item.dataset.tags ?? '[]');
      return Array.isArray(value) ? value.filter((tag): tag is string => typeof tag === 'string') : [];
    } catch {
      return [];
    }
  }

  function applyFilters(): void {
    const { category, tag } = selectedFilters();
    let visible = 0;

    for (const item of items) {
      const categoryMatch = !category || item.dataset.category === category;
      const tagMatch = !tag || tagsOf(item).includes(tag);
      const show = categoryMatch && tagMatch;
      item.hidden = !show;
      if (show) visible += 1;
    }

    if (countElement) countElement.textContent = String(visible);
    if (emptyElement) emptyElement.hidden = visible !== 0;
    if (clearButton) clearButton.hidden = !category && !tag;

    document.querySelectorAll<HTMLAnchorElement>('[data-tag-link]').forEach((link) => {
      const active = (link.dataset.tag ?? '') === tag;
      link.classList.toggle('chip-active', active);
      link.setAttribute('aria-pressed', String(active));
      if (active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-category-link]').forEach((link) => {
      const active = (link.dataset.category ?? '') === category;
      link.classList.toggle('chip-active', active);
      if (active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }

  function urlForLink(link: HTMLAnchorElement): URL {
    const url = new URL(link.href, window.location.href);
    const current = selectedFilters();

    if (link.hasAttribute('data-tag-link') && current.category) {
      url.searchParams.set('category', current.category);
    }
    if (link.hasAttribute('data-category-link') && current.tag) {
      url.searchParams.set('tag', current.tag);
    }

    return url;
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-filter-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
        return;
      }
      event.preventDefault();
      const url = urlForLink(link);
      window.history.pushState({}, '', `${url.pathname}${url.search}${url.hash}`);
      applyFilters();
    });
  });

  clearButton?.addEventListener('click', () => {
    window.history.pushState({}, '', window.location.pathname);
    applyFilters();
  });

  window.addEventListener('popstate', applyFilters);
  applyFilters();
</script>
