---
import { isConfigured, site, withBase } from '../consts';

const year = new Date().getFullYear();
const configured = isConfigured();
---

<footer class="mt-16 border-t border-slate-200/60 bg-white/30 backdrop-blur-sm dark:border-white/10 dark:bg-white/[0.02]">
  <div class="mx-auto max-w-[88rem] px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <a href={withBase('/')} class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-rose-300 to-violet-400 text-xs font-bold text-white">y</span>
          <span class="font-display text-lg font-semibold text-ink dark:text-white">{site.name}</span>
        </a>
        <p class="mt-3 text-xs leading-6 text-slate-500 dark:text-slate-400">
          {site.description}。内容以 Markdown 与图片的形式存放在 GitHub 仓库，构建后发布。
        </p>
        <p class="mt-2 inline-flex items-center gap-1.5 rounded-full border border-slate-200/70 bg-white/50 px-2.5 py-1 text-[0.62rem] text-slate-400 dark:border-white/10 dark:bg-white/5 dark:text-slate-500">
          <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M12 3 4.5 6v5c0 4.5 3 7.5 7.5 10 4.5-2.5 7.5-5.5 7.5-10V6Z" stroke-linejoin="round"></path>
            <path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          已禁止搜索引擎抓取
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 text-xs sm:grid-cols-3">
        <div>
          <p class="mb-2 font-semibold text-slate-600 dark:text-slate-300">浏览</p>
          <ul class="space-y-1.5 text-slate-500 dark:text-slate-400">
            <li><a href={withBase('/posts/')} class="transition hover:text-rose-500">文章</a></li>
            <li><a href={withBase('/illustrations/')} class="transition hover:text-rose-500">插画</a></li>
            <li><a href={withBase('/archive/')} class="transition hover:text-rose-500">归档</a></li>
          </ul>
        </div>
        <div>
          <p class="mb-2 font-semibold text-slate-600 dark:text-slate-300">站点</p>
          <ul class="space-y-1.5 text-slate-500 dark:text-slate-400">
            <li><a href={withBase('/about/')} class="transition hover:text-rose-500">关于</a></li>
            <li><a href={withBase('/admin/')} class="transition hover:text-rose-500">后台</a></li>
            <li><a href={withBase('/robots.txt')} class="transition hover:text-rose-500">robots.txt</a></li>
          </ul>
        </div>
        <div>
          <p class="mb-2 font-semibold text-slate-600 dark:text-slate-300">连接</p>
          <ul class="space-y-1.5 text-slate-500 dark:text-slate-400">
            {
              configured && (
                <li>
                  <a
                    href={`https://github.com/${site.githubUsername}/${site.repoName}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition hover:text-rose-500"
                  >
                    GitHub 仓库
                  </a>
                </li>
              )
            }
            {site.email && <li><a href={`mailto:${site.email}`} class="transition hover:text-rose-500">邮件</a></li>}
            <li><a href={withBase('/admin/')} class="transition hover:text-rose-500">内容管理</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-slate-200/60 pt-5 text-[0.65rem] text-slate-400 dark:border-white/10 dark:text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. 保留所有文字与图片的权利。</p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>Private archive</span>
        <span class="hidden h-0.5 w-0.5 rounded-full bg-slate-300 sm:inline-block dark:bg-slate-600"></span>
        <span>Built with Astro · Sveltia CMS · Pagefind</span>
      </p>
    </div>
  </div>
</footer>
