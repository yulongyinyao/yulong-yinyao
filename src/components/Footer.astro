---
import { isConfigured, site, withBase } from '../consts';

const year = new Date().getFullYear();
const configured = isConfigured();
---

<footer class="mt-16 border-t border-slate-200/60 bg-white/30 backdrop-blur-sm dark:border-white/10 dark:bg-white/[0.02]">
  <div class="mx-auto max-w-[88rem] px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <a href={withBase('/')} class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-rose-300 to-violet-400 text-xs font-bold text-white">银</span>
        <span class="font-display text-lg font-semibold text-ink dark:text-white">{site.displayName}</span>
      </a>

      <div class="grid grid-cols-2 gap-8 text-xs sm:grid-cols-3">
        <div>
          <p class="mb-2 font-semibold text-slate-600 dark:text-slate-300">浏览</p>
          <ul class="space-y-1.5 text-slate-500 dark:text-slate-400">
            <li><a href={withBase('/posts/')} class="transition hover:text-rose-500">文章</a></li>
            <li><a href={withBase('/illustrations/')} class="transition hover:text-rose-500">插画</a></li>
            <li><a href={withBase('/archive/')} class="transition hover:text-rose-500">归档</a></li>
          </ul>
        </div>
        <div>
          <p class="mb-2 font-semibold text-slate-600 dark:text-slate-300">站点</p>
          <ul class="space-y-1.5 text-slate-500 dark:text-slate-400">
            <li><a href={withBase('/about/')} class="transition hover:text-rose-500">关于</a></li>
            <li><a href={withBase('/admin/')} class="transition hover:text-rose-500">后台</a></li>
            <li><a href={withBase('/robots.txt')} class="transition hover:text-rose-500">robots.txt</a></li>
          </ul>
        </div>
        <div>
          <p class="mb-2 font-semibold text-slate-600 dark:text-slate-300">连接</p>
          <ul class="space-y-1.5 text-slate-500 dark:text-slate-400">
            {
              configured && (
                <li>
                  <a
                    href={`https://github.com/${site.githubUsername}/${site.repoName}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition hover:text-rose-500"
                  >
                    GitHub 仓库
                  </a>
                </li>
              )
            }
            {site.email && <li><a href={`mailto:${site.email}`} class="transition hover:text-rose-500">邮件</a></li>}
            <li><a href={withBase('/admin/')} class="transition hover:text-rose-500">内容管理</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-slate-200/60 pt-5 text-[0.65rem] text-slate-400 dark:border-white/10 dark:text-slate-500">
      <p>© {year} {site.name}</p>
    </div>
  </div>
</footer>
