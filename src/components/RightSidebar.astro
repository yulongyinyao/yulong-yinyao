---
import { withBase } from '../consts';

interface TagItem {
  name: string;
  count: number;
  href: string;
}

interface RecentItem {
  title: string;
  href: string;
  date: string;
  type: 'post' | 'illustration';
}

interface Props {
  postCount: number;
  illustrationCount: number;
  categoryCount: number;
  tagCount: number;
  tags: TagItem[];
  recent: RecentItem[];
  compact?: boolean;
}

const {
  postCount,
  illustrationCount,
  categoryCount,
  tagCount,
  tags,
  recent,
  compact = false,
} = Astro.props;

const maxTagCount = Math.max(1, ...tags.map((tag) => tag.count));

function tagSize(count: number): string {
  const ratio = count / maxTagCount;
  if (ratio >= 0.8) return 'text-sm font-semibold';
  if (ratio >= 0.5) return 'text-[0.8rem] font-medium';
  return 'text-xs';
}
---

<aside class:list={['space-y-4', compact && 'lg:hidden']} aria-label="站点统计">
  <section class="card p-5">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-base font-semibold text-ink dark:text-white">站点统计</h2>
      <span class="grid h-8 w-8 place-items-center rounded-full bg-violet-50 text-violet-500 dark:bg-violet-400/10 dark:text-violet-300">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 19V9m5 10V5m5 14v-7m5 7V3" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>

    <dl class="mt-4 grid grid-cols-2 gap-2">
      <div class="rounded-xl bg-gradient-to-br from-rose-50 to-rose-100/60 px-3 py-3 dark:from-rose-400/10 dark:to-rose-400/5">
        <dt class="text-[0.65rem] tracking-wide text-rose-700/70 dark:text-rose-200/70">文章</dt>
        <dd class="mt-1 font-display text-2xl font-semibold text-rose-600 dark:text-rose-200">{postCount}</dd>
      </div>
      <div class="rounded-xl bg-gradient-to-br from-violet-50 to-violet-100/60 px-3 py-3 dark:from-violet-400/10 dark:to-violet-400/5">
        <dt class="text-[0.65rem] tracking-wide text-violet-700/70 dark:text-violet-200/70">插画</dt>
        <dd class="mt-1 font-display text-2xl font-semibold text-violet-600 dark:text-violet-200">{illustrationCount}</dd>
      </div>
      <div class="rounded-xl bg-white/60 px-3 py-2.5 dark:bg-white/5">
        <dt class="text-[0.65rem] tracking-wide text-slate-500 dark:text-slate-400">分类</dt>
        <dd class="mt-0.5 font-display text-lg font-semibold text-ink dark:text-white">{categoryCount}</dd>
      </div>
      <div class="rounded-xl bg-white/60 px-3 py-2.5 dark:bg-white/5">
        <dt class="text-[0.65rem] tracking-wide text-slate-500 dark:text-slate-400">标签</dt>
        <dd class="mt-0.5 font-display text-lg font-semibold text-ink dark:text-white">{tagCount}</dd>
      </div>
    </dl>
  </section>

  <section class="card p-5">
    <div class="flex items-center justify-between gap-2">
      <h2 class="font-display text-base font-semibold text-ink dark:text-white">标签云</h2>
      <a href={withBase('/archive/')} class="text-[0.65rem] text-slate-400 transition hover:text-rose-500 dark:text-slate-500 dark:hover:text-rose-300">
        全部
      </a>
    </div>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {
        tags.length > 0 ? (
          tags.map((tag) => (
            <a href={tag.href} class:list={['chip-muted', tagSize(tag.count)]}>
              #{tag.name}
              <span class="text-[0.6rem] opacity-50">{tag.count}</span>
            </a>
          ))
        ) : (
          <p class="text-xs text-slate-500 dark:text-slate-400">还没有标签，发布内容后会自动出现。</p>
        )
      }
    </div>
  </section>

  {
    !compact && (
      <section class="card p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-display text-base font-semibold text-ink dark:text-white">最近更新</h2>
          <a href={withBase('/archive/')} class="text-[0.65rem] text-slate-400 transition hover:text-rose-500 dark:text-slate-500 dark:hover:text-rose-300">
            查看
          </a>
        </div>
        <ol class="mt-3 space-y-3">
          {
            recent.slice(0, 5).map((item, index) => (
              <li class="group flex gap-3">
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-lg bg-slate-100 text-[0.6rem] font-semibold text-slate-500 dark:bg-white/10 dark:text-slate-300">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0">
                  <a href={item.href} class="line-clamp-2 text-xs font-medium leading-5 text-slate-700 transition group-hover:text-rose-600 dark:text-slate-200 dark:group-hover:text-rose-300">
                    {item.title}
                  </a>
                  <p class="mt-0.5 text-[0.62rem] text-slate-400 dark:text-slate-500">
                    {item.date} · {item.type === 'post' ? '文章' : '插画'}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    )
  }

  <section class="card-soft p-4">
    <p class="text-[0.65rem] leading-5 text-slate-500 dark:text-slate-400">
      这个站点没有评论、没有算法，只有按时间收好的字和画。
    </p>
  </section>
</aside>
