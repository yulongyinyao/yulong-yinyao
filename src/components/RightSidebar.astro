---
import Calendar from './Calendar.astro';
import NowCard from './NowCard.astro';

interface RecentItem {
  title: string;
  href: string;
  date: string;
  type: 'post' | 'illustration';
}

interface Props {
  postCount: number;
  illustrationCount: number;
  categoryCount: number;
  tagCount: number;
  noteCount?: number;
  projectCount?: number;
  recent: RecentItem[];
  compact?: boolean;
}

const {
  postCount,
  illustrationCount,
  categoryCount,
  tagCount,
  noteCount = 0,
  projectCount = 0,
  compact = false,
} = Astro.props;
---

<aside class:list={['space-y-4', compact && 'lg:hidden']} aria-label="站点统计">
  <Calendar />
  <NowCard />

  <section class="card p-5">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-base font-semibold text-ink dark:text-white">站点统计</h2>
      <span class="grid h-8 w-8 place-items-center rounded-full bg-violet-50 text-violet-500 dark:bg-violet-400/10 dark:text-violet-300">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 19V9m5 10V5m5 14v-7m5 7V3" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>

    <dl class="mt-4 grid grid-cols-2 gap-2">
      <div class="rounded-xl bg-gradient-to-br from-rose-50 to-rose-100/60 px-3 py-3 dark:from-rose-400/10 dark:to-rose-400/5">
        <dt class="text-[0.65rem] tracking-wide text-rose-700/70 dark:text-rose-200/70">文章</dt>
        <dd class="mt-1 font-display text-2xl font-semibold text-rose-600 dark:text-rose-200">{postCount}</dd>
      </div>
      <div class="rounded-xl bg-gradient-to-br from-violet-50 to-violet-100/60 px-3 py-3 dark:from-violet-400/10 dark:to-violet-400/5">
        <dt class="text-[0.65rem] tracking-wide text-violet-700/70 dark:text-violet-200/70">插画</dt>
        <dd class="mt-1 font-display text-2xl font-semibold text-violet-600 dark:text-violet-200">{illustrationCount}</dd>
      </div>
      <div class="rounded-xl bg-white/60 px-3 py-2.5 dark:bg-white/5">
        <dt class="text-[0.65rem] tracking-wide text-slate-500 dark:text-slate-400">分类</dt>
        <dd class="mt-0.5 font-display text-lg font-semibold text-ink dark:text-white">{categoryCount}</dd>
      </div>
      <div class="rounded-xl bg-white/60 px-3 py-2.5 dark:bg-white/5">
        <dt class="text-[0.65rem] tracking-wide text-slate-500 dark:text-slate-400">标签</dt>
        <dd class="mt-0.5 font-display text-lg font-semibold text-ink dark:text-white">{tagCount}</dd>
      </div>
    </dl>
    <p class="mt-3 border-t border-slate-200/50 pt-3 text-[0.65rem] text-slate-400 dark:border-white/10 dark:text-slate-500">
      说说 {noteCount} · 项目 {projectCount}
    </p>
  </section>

</aside>
