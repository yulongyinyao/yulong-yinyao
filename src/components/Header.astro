---
import { site, withBase } from '../consts';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const homePath = withBase('/').replace(/\/+$/, '') || '/';
const isHome = current === homePath;

const navItems = [
  { label: '首页', href: withBase('/') },
  { label: '文章', href: withBase('/posts/') },
  { label: '插画', href: withBase('/illustrations/') },
  { label: '归档', href: withBase('/archive/') },
  { label: '关于', href: withBase('/about/') },
];

function isActive(href: string): boolean {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === withBase('/').replace(/\/+$/, '')) return current === target;
  return current === target || current.startsWith(`${target}/`);
}
---

<header
  class="site-header sticky top-0 z-50 border-b backdrop-blur-xl"
  data-transparent={isHome ? 'true' : undefined}
>
  <div class="mx-auto flex h-16 max-w-[88rem] items-center justify-between gap-4 px-4 sm:px-6 lg:h-[4.5rem] lg:px-8">
    <a href={withBase('/')} class="group flex min-w-0 items-center gap-2.5" aria-label={`${site.displayName} 首页`}>
      <span class="relative grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-rose-300 via-rose-400 to-violet-400 text-sm font-bold text-white shadow-md shadow-rose-300/30 transition group-hover:rotate-3">
        银
        <span class="absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full border-2 border-cream bg-amber-300 dark:border-[#17110d]"></span>
      </span>
      <span class="site-title truncate font-display text-lg font-semibold tracking-tight text-ink transition-colors dark:text-white sm:text-xl">
        {site.displayName}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', isActive(item.href) && 'nav-link-active']}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="icon-button"
        data-search-open
        aria-label="打开站内搜索"
        title="搜索（Ctrl / ⌘ + K）"
      >
        <svg viewBox="0 0 24 24" class="h-[1.15rem] w-[1.15rem]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4.2 4.2" stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        type="button"
        class="icon-button"
        id="theme-toggle"
        aria-label="切换深色模式"
        aria-pressed="false"
        title="切换深色 / 明亮模式"
      >
        <svg viewBox="0 0 24 24" class="h-[1.15rem] w-[1.15rem] dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z" stroke-linejoin="round"></path>
        </svg>
        <svg viewBox="0 0 24 24" class="hidden h-[1.15rem] w-[1.15rem] dark:block" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        type="button"
        class="icon-button md:hidden"
        id="menu-toggle"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-menu-icon="open">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
        <svg viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-menu-icon="close">
          <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/50 bg-cream/95 px-4 pb-4 pt-2 backdrop-blur-xl dark:border-white/10 dark:bg-[#17110d]/95 md:hidden">
    <nav class="mx-auto grid max-w-[88rem] gap-1" aria-label="移动端导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center justify-between rounded-xl px-3 py-3 text-sm font-medium transition',
              isActive(item.href)
                ? 'bg-white/80 text-ink shadow-sm dark:bg-white/10 dark:text-white'
                : 'text-slate-600 hover:bg-white/60 dark:text-slate-300 dark:hover:bg-white/10',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span>{item.label}</span>
            <svg viewBox="0 0 24 24" class="h-4 w-4 opacity-40" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeButton = document.getElementById('theme-toggle');
  const themeColor = document.querySelector('meta[name="theme-color"]');
  const header = document.querySelector('.site-header');

  function syncThemeButton(): void {
    if (!(themeButton instanceof HTMLButtonElement)) return;
    const dark = root.classList.contains('dark');
    themeButton.setAttribute('aria-pressed', String(dark));
    themeButton.setAttribute('aria-label', dark ? '切换到明亮模式' : '切换到深色模式');
    if (themeColor) {
      themeColor.setAttribute('content', dark ? '#17110d' : '#f7efe7');
    }
  }

  function syncHeader(): void {
    if (!(header instanceof HTMLElement) || header.dataset.transparent !== 'true') return;
    header.classList.toggle('is-scrolled', window.scrollY > 32);
  }

  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });

  themeButton?.addEventListener('click', () => {
    const dark = !root.classList.contains('dark');
    root.classList.toggle('dark', dark);
    root.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      /* localStorage may be unavailable in private mode. */
    }
    syncThemeButton();
  });

  syncThemeButton();

  const menuButton = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  function setMenu(open: boolean): void {
    if (!(menuButton instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    mobileMenu.classList.toggle('hidden', !open);
    menuButton.querySelector('[data-menu-icon="open"]')?.classList.toggle('hidden', open);
    menuButton.querySelector('[data-menu-icon="close"]')?.classList.toggle('hidden', !open);
  }

  menuButton?.addEventListener('click', () => {
    setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 768px)').matches) setMenu(false);
  });
</script>
