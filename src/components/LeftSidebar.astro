---
import { site, withBase } from '../consts';

interface Props {
  postCount: number;
  illustrationCount: number;
}

const { postCount, illustrationCount } = Astro.props;
const githubUrl =
  site.githubUsername && site.githubUsername !== 'your-github-username'
    ? `https://github.com/${site.githubUsername}`
    : '';
const startYear = site.startDate?.slice(0, 4) || '';
---

<aside class="card overflow-hidden" aria-label="个人资料">
  <div class="relative h-24 overflow-hidden bg-gradient-to-br from-rose-200 via-rose-100 to-violet-200 dark:from-rose-400/20 dark:via-violet-400/10 dark:to-violet-500/20">
    <div class="absolute -right-6 -top-8 h-28 w-28 rounded-full bg-white/30 blur-xl"></div>
    <div class="absolute -bottom-10 left-8 h-24 w-24 rounded-full bg-violet-300/30 blur-xl"></div>
    <p class="absolute bottom-3 right-4 font-display text-[0.65rem] tracking-[0.25em] text-rose-700/45 dark:text-rose-100/45">
      PRIVATE ARCHIVE
    </p>
  </div>

  <div class="-mt-10 px-5 pb-5">
    <a
      href={withBase('/about/')}
      class="relative block h-20 w-20 rounded-2xl border-4 border-white bg-white shadow-lg transition hover:-translate-y-0.5 dark:border-[#1b1726] dark:bg-[#1b1726]"
      aria-label="关于我"
    >
      <img
        src={withBase(site.avatar)}
        alt={`${site.name} 的头像`}
        class="h-full w-full rounded-xl object-cover"
        loading="lazy"
        decoding="async"
      />
      <span class="absolute -bottom-1 -right-1 grid h-6 w-6 place-items-center rounded-full border-2 border-white bg-emerald-400 dark:border-[#1b1726]">
        <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
      </span>
    </a>

    <h2 class="mt-3 font-display text-xl font-semibold tracking-tight text-ink dark:text-white">
      {site.name}
    </h2>
    <p class="mt-1 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-rose-500/80 dark:text-rose-300/80">
      writing &amp; drawing
    </p>
    <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{site.bio}</p>

    <dl class="mt-5 grid grid-cols-2 gap-2">
      <div class="card-soft px-3 py-2.5">
        <dt class="text-[0.65rem] tracking-wide text-slate-500 dark:text-slate-400">文章</dt>
        <dd class="mt-0.5 font-display text-lg font-semibold text-ink dark:text-white">{postCount}</dd>
      </div>
      <div class="card-soft px-3 py-2.5">
        <dt class="text-[0.65rem] tracking-wide text-slate-500 dark:text-slate-400">插画</dt>
        <dd class="mt-0.5 font-display text-lg font-semibold text-ink dark:text-white">{illustrationCount}</dd>
      </div>
    </dl>

    <div class="mt-5 flex items-center gap-2">
      {
        githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer me"
            class="icon-button"
            aria-label="GitHub 主页"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem]" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
            </svg>
          </a>
        )
      }
      {
        site.email && (
          <a href={`mailto:${site.email}`} class="icon-button" aria-label="发送邮件" title="邮件">
            <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        )
      }
      <a href={withBase('/about/')} class="chip-muted ml-auto" aria-label="了解更多">
        关于我
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    {
      startYear && (
        <p class="mt-4 border-t border-slate-200/70 pt-3 text-[0.65rem] tracking-wide text-slate-400 dark:border-white/10 dark:text-slate-500">
          since {startYear} · 慢慢写，慢慢画
        </p>
      )
    }
  </div>
</aside>
