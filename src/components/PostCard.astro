---
import type { CollectionEntry } from 'astro:content';
import {
  excerpt,
  formatDate,
  postHref,
  readingTime,
  withBase,
} from '../consts';
import { categoryLabel } from '../data/categories';

interface Props {
  post: CollectionEntry<'posts'>;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const href = postHref(post.id);
const cover = post.data.cover ? withBase(post.data.cover) : '';
const summary = excerpt(post.body ?? '', compact ? 78 : 118);
const minutes = readingTime(post.body ?? '');
---

<article
  class="group card overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-[0_26px_60px_-30px_rgba(100,60,120,0.55)]"
  data-filter-item
  data-category={post.data.category}
  data-tags={JSON.stringify(post.data.tags)}
>
  <a href={href} class="block" aria-label={`阅读：${post.data.title}`}>
    <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-rose-100 via-violet-100 to-slate-100 dark:from-rose-400/15 dark:via-violet-400/10 dark:to-white/5">
      {
        cover ? (
          <img
            src={cover}
            alt=""
            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.035]"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="grid h-full place-items-center">
            <span class="font-display text-3xl text-rose-300/80 dark:text-rose-200/40">y</span>
          </div>
        )
      }
      <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-black/25 to-transparent opacity-0 transition group-hover:opacity-100"></div>
      <span class="absolute left-3 top-3 rounded-full border border-white/40 bg-white/80 px-2.5 py-1 text-[0.65rem] font-semibold text-rose-700 backdrop-blur dark:border-white/10 dark:bg-black/40 dark:text-rose-200">
        {categoryLabel('post', post.data.category)}
      </span>
    </div>
  </a>

  <div class="p-5">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.66rem] tracking-wide text-slate-400 dark:text-slate-500">
      <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
      <span class="h-0.5 w-0.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
      <span>{minutes} 分钟阅读</span>
    </div>

    <h3 class="mt-2 font-display text-lg font-semibold leading-snug tracking-tight text-ink dark:text-white">
      <a href={href} class="transition group-hover:text-rose-600 dark:group-hover:text-rose-300">
        {post.data.title}
      </a>
    </h3>

    {summary && (
      <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{summary}</p>
    )}

    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      {post.data.tags.slice(0, compact ? 3 : 4).map((tag) => (
        <a href={`${withBase('/posts/')}?tag=${encodeURIComponent(tag)}`} class="chip">
          #{tag}
        </a>
      ))}
      <a href={href} class="ml-auto inline-flex items-center gap-1 text-[0.7rem] font-medium text-rose-500 transition hover:gap-1.5 hover:text-rose-600 dark:text-rose-300">
        阅读
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
