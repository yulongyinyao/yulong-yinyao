---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../consts';
---

<BaseLayout title="页面走丢了">
  <div class="mx-auto flex min-h-[68vh] max-w-3xl items-center px-4 py-16 sm:px-6">
    <div class="card w-full px-6 py-12 text-center sm:px-12">
      <p class="font-display text-[5.5rem] font-semibold leading-none tracking-tight text-transparent sm:text-[7rem]" style="background-image: linear-gradient(120deg, #ad86ae, #746097); background-clip: text; -webkit-background-clip: text;">
        404
      </p>
      <h1 class="mt-4 font-display text-2xl font-semibold tracking-tight text-ink dark:text-white">
        这一页走丢了
      </h1>
      <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-slate-600 dark:text-slate-300">
        可能是链接换了位置，也可能它只是一张还没来得及画完的草稿。回到有光的地方吧。
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-2">
        <a href={withBase('/')} class="chip">回到首页</a>
        <a href={withBase('/archive/')} class="chip-muted">看看归档</a>
        <a href={withBase('/posts/')} class="chip-muted">读文章</a>
      </div>
    </div>
  </div>
</BaseLayout>
