---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, withBase } from '../consts';

const repo = `${site.githubUsername}/${site.repoName}`;
const repoUrl = `https://github.com/${repo}`;
const tokenUrl = 'https://github.com/settings/personal-access-tokens/new';
---

<BaseLayout title="内容编辑器" description="银曜的个人博客：文章与插画编辑。" pagefindIgnore versionCheck={false}>
  <div
    id="editor-root"
    class="mx-auto max-w-[88rem] px-4 py-8 sm:px-6 lg:px-8"
    data-repo={repo}
    data-base={withBase('/')}
  >
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.3em] text-rose-500/80 dark:text-rose-300/80">
          Editor
        </p>
        <h1 class="mt-1 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">
          内容编辑器
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-500 dark:text-slate-400">
          直接在这里写文章、整理插画、上传图片。保存后会提交到 GitHub，并自动触发站点重新发布。
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href={repoUrl} target="_blank" rel="noreferrer" class="btn-ghost">仓库</a>
        <button id="logout-button" type="button" class="btn-ghost hidden">退出</button>
      </div>
    </div>

    <section id="auth-panel" class="mx-auto max-w-2xl">
      <div class="card p-6 sm:p-8">
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.3em] text-violet-500/80 dark:text-violet-300/80">
          Connect
        </p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink dark:text-white">连接 GitHub</h2>
        <p class="mt-2 text-sm leading-7 text-slate-500 dark:text-slate-400">
          用一个只属于这台设备的 GitHub Token 登录。Token 只保存在当前浏览器，不会写进仓库。
        </p>

        <form id="auth-form" class="mt-6 space-y-4">
          <div>
            <label class="field-label" for="token-input">Fine-grained personal access token</label>
            <input
              id="token-input"
              class="field font-mono"
              type="password"
              placeholder="github_pat_..."
              autocomplete="off"
              spellcheck="false"
              required
            />
          </div>

          <label class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
            <input id="remember-token" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-rose-500" checked />
            在这台浏览器记住（关闭页面后仍保持登录）
          </label>

          <div class="flex flex-wrap items-center gap-3">
            <button id="auth-submit" type="submit" class="btn-primary">连接并开始编辑</button>
            <span id="auth-status" class="text-xs text-slate-400"></span>
          </div>
        </form>

        <details class="mt-6 rounded-xl border border-slate-200/80 bg-white/45 p-4 text-sm text-slate-500 dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
          <summary class="cursor-pointer font-medium text-slate-600 dark:text-slate-300">第一次使用？点开看 Token 怎么生成</summary>
          <ol class="mt-3 list-decimal space-y-2 pl-5 leading-6">
            <li>
              打开
              <a href={tokenUrl} target="_blank" rel="noreferrer" class="text-rose-600 underline underline-offset-4 dark:text-rose-300"
                >GitHub → Fine-grained tokens → Generate new token</a
              >。
            </li>
            <li>Repository access 选 “Only select repositories”，选中 <code class="rounded bg-slate-100 px-1 py-0.5 text-[0.75em] dark:bg-white/10">{repo}</code>。</li>
            <li>Permissions → Repository permissions：<strong>Contents</strong> 设为 <strong>Read and write</strong>；Metadata 会自动变成 Read-only。</li>
            <li>生成后复制 <code class="rounded bg-slate-100 px-1 py-0.5 text-[0.75em] dark:bg-white/10">github_pat_...</code>，粘贴到上面。</li>
            <li>建议设置 90 天过期；过期后回到这里换一个新 Token 即可。</li>
          </ol>
        </details>
      </div>
    </section>

    <section id="app-panel" class="hidden">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-1 rounded-full border border-white/70 bg-white/45 p-1 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5">
          <button type="button" class="editor-tab editor-tab-active" data-view="posts">文章</button>
          <button type="button" class="editor-tab" data-view="illustrations">插画</button>
          <button type="button" class="editor-tab" data-view="notes">说说</button>
          <button type="button" class="editor-tab" data-view="projects">项目</button>
          <button type="button" class="editor-tab" data-view="media">媒体库</button>
          <button type="button" class="editor-tab" data-view="settings">站点</button>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span id="editor-status" class="mr-1 text-xs text-slate-400"></span>
          <button id="new-post" type="button" class="btn-primary">+ 文章</button>
          <button id="new-illustration" type="button" class="btn-ghost">+ 插画</button>
          <button id="new-note" type="button" class="btn-ghost">+ 说说</button>
          <button id="new-project" type="button" class="btn-ghost">+ 项目</button>
          <button id="refresh-button" type="button" class="btn-ghost">刷新</button>
        </div>
      </div>

      <div id="content-workspace" class="grid items-start gap-5 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <aside class="card overflow-hidden">
          <div class="flex items-center justify-between border-b border-slate-200/60 px-4 py-3 dark:border-white/10">
            <h2 id="list-title" class="font-display text-lg font-semibold text-ink dark:text-white">文章</h2>
            <span id="list-count" class="text-xs text-slate-400"></span>
          </div>
          <div id="item-list" class="max-h-[70vh] space-y-1 overflow-y-auto p-2"></div>
        </aside>

        <div class="min-w-0">
          <div id="form-empty" class="card flex min-h-[24rem] flex-col items-center justify-center p-10 text-center">
            <p class="font-display text-xl font-semibold text-ink dark:text-white">选择左侧内容，或新建一篇</p>
            <p class="mt-2 max-w-md text-sm leading-7 text-slate-500 dark:text-slate-400">
              文章、说说和项目用 Markdown 写，插画可以一次上传多张图片。保存后会自动提交到 GitHub。
            </p>
            <div class="mt-5 flex flex-wrap justify-center gap-2">
              <button type="button" class="btn-primary" data-new="posts">新建文章</button>
              <button type="button" class="btn-ghost" data-new="illustrations">新建插画</button>
              <button type="button" class="btn-ghost" data-new="notes">新建说说</button>
              <button type="button" class="btn-ghost" data-new="projects">新建项目</button>
            </div>
          </div>

          <form id="content-form" class="card hidden space-y-5 p-5 sm:p-7">
            <input id="field-type" type="hidden" />

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="sm:col-span-2">
                <span class="field-label">标题</span>
                <input id="field-title" class="field" type="text" placeholder="给这篇内容起一个名字" />
              </label>
              <label>
                <span class="field-label">日期</span>
                <input id="field-date" class="field" type="date" required />
              </label>
              <label id="category-field">
                <span class="field-label">分类</span>
                <select id="field-category" class="field"></select>
              </label>
              <label class="sm:col-span-2">
                <span class="field-label">标签</span>
                <input id="field-tags" class="field" type="text" placeholder="用逗号分隔，例如：随笔, 花园, 夜色" />
              </label>
            </div>

            <label class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
              <input id="field-draft" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-rose-500" />
              设为草稿（暂不显示在站点）
            </label>

            <div id="post-fields" class="space-y-5">
              <div id="cover-block">
                <span class="field-label">封面</span>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
                  <div class="flex h-28 w-full shrink-0 items-center justify-center overflow-hidden rounded-xl border border-dashed border-slate-200/90 bg-slate-50/60 sm:w-44 dark:border-white/10 dark:bg-white/5">
                    <img id="cover-preview" class="hidden h-full w-full object-cover" alt="封面预览" />
                    <span id="cover-placeholder" class="px-3 text-center text-xs text-slate-400">还没有封面</span>
                  </div>
                  <div class="min-w-0 flex-1 space-y-2">
                    <input id="field-cover" class="field font-mono text-xs" type="text" placeholder="/uploads/posts/..." />
                    <div class="flex flex-wrap gap-2">
                      <button id="cover-upload-button" type="button" class="btn-ghost">上传封面</button>
                      <input id="cover-file" class="hidden" type="file" accept="image/*" />
                      <button id="cover-clear" type="button" class="btn-ghost">清除</button>
                    </div>
                  </div>
                </div>
              </div>

              <div id="project-fields" class="hidden space-y-5">
                <label class="block">
                  <span class="field-label">一句话简介</span>
                  <textarea
                    id="field-summary"
                    class="field min-h-[5rem] resize-y leading-7"
                    placeholder="这个项目是做什么的？一两句话就够。"
                  ></textarea>
                </label>
                <div class="grid gap-4 sm:grid-cols-2">
                  <label>
                    <span class="field-label">项目链接</span>
                    <input id="field-link" class="field font-mono text-xs" type="url" placeholder="https://..." />
                  </label>
                  <label>
                    <span class="field-label">仓库链接</span>
                    <input id="field-repo" class="field font-mono text-xs" type="url" placeholder="https://github.com/..." />
                  </label>
                </div>
                <label class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                  <input id="field-featured" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-rose-500" />
                  设为精选项目（显示在首页）
                </label>
              </div>

              <label class="block">
                <span class="field-label">正文（Markdown）</span>
                <textarea
                  id="field-body"
                  class="field min-h-[22rem] resize-y font-mono text-[0.82rem] leading-7"
                  placeholder="从这里开始写。支持 Markdown、标题、列表、引用和图片。"
                ></textarea>
              </label>
            </div>

            <div id="illustration-fields" class="hidden space-y-5">
              <label class="block">
                <span class="field-label">描述</span>
                <textarea
                  id="field-description"
                  class="field min-h-[6rem] resize-y leading-7"
                  placeholder="写一点关于这组画的话。"
                ></textarea>
              </label>

              <div>
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                  <span class="field-label mb-0">图片</span>
                  <div class="flex gap-2">
                    <button id="illustration-upload-button" type="button" class="btn-ghost">上传图片</button>
                    <input id="illustration-file" class="hidden" type="file" accept="image/*" multiple />
                  </div>
                </div>
                <div id="illustration-images" class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
                <p class="mt-2 text-[0.7rem] text-slate-400">可以一次选多张；上传后会立即提交到仓库。建议长边不超过 2000px。</p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 border-t border-slate-200/60 pt-5 dark:border-white/10">
              <button id="save-button" type="submit" class="btn-primary">保存并发布</button>
              <button id="preview-button" type="button" class="btn-ghost">预览</button>
              <button id="delete-button" type="button" class="btn-danger ml-auto hidden">删除</button>
            </div>

            <div id="preview-panel" class="hidden rounded-xl border border-slate-200/80 bg-white/55 p-4 dark:border-white/10 dark:bg-white/5">
              <div class="mb-3 flex items-center justify-between">
                <h3 class="font-display text-lg font-semibold text-ink dark:text-white">预览</h3>
                <button id="close-preview" type="button" class="text-xs text-slate-400 hover:text-rose-500">关闭</button>
              </div>
              <div id="preview-content"></div>
            </div>
          </form>
        </div>
      </div>

      <section id="media-view" class="hidden">
        <div class="card p-5 sm:p-7">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="font-display text-2xl font-semibold text-ink dark:text-white">媒体库</h2>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                仓库里 <code class="rounded bg-slate-100 px-1 py-0.5 text-[0.75em] dark:bg-white/10">public/uploads/</code> 下的图片。
                可以设为文章封面、加入插画，或直接删除。
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <select id="media-folder" class="field w-auto py-2 text-xs">
                <option value="posts">文章配图</option>
                <option value="illustrations">插画</option>
                <option value="projects">项目封面</option>
                <option value="site">站点头像</option>
              </select>
              <button id="media-upload-button" type="button" class="btn-primary">上传图片</button>
              <input id="media-file" class="hidden" type="file" accept="image/*" multiple />
            </div>
          </div>
          <div id="media-grid" class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"></div>
        </div>
      </section>

      <section id="settings-view" class="hidden">
        <div class="grid items-start gap-5 lg:grid-cols-2">
          <div class="card p-5 sm:p-7">
            <h2 class="font-display text-2xl font-semibold text-ink dark:text-white">个人卡片</h2>
            <p class="mt-1 text-sm leading-7 text-slate-500 dark:text-slate-400">
              修改首页左侧卡片的头像和简介。头像会同时用于站点图标和分享封面。
            </p>

            <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-start">
              <div class="flex h-28 w-28 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-dashed border-slate-200/90 bg-slate-50/60 dark:border-white/10 dark:bg-white/5">
                <img id="settings-avatar-preview" class="hidden h-full w-full object-cover" alt="头像预览" />
                <span id="settings-avatar-placeholder" class="px-3 text-center text-xs text-slate-400">还没有头像</span>
              </div>
              <div class="min-w-0 flex-1 space-y-2">
                <input id="settings-avatar" class="field font-mono text-xs" type="text" placeholder="/uploads/site/avatar..." />
                <div class="flex flex-wrap gap-2">
                  <button id="avatar-upload-button" type="button" class="btn-ghost">上传头像</button>
                  <input id="avatar-file" class="hidden" type="file" accept="image/*" />
                </div>
                <select id="settings-avatar-media" class="field py-2 text-xs">
                  <option value="">从媒体库选择…</option>
                </select>
              </div>
            </div>

            <label class="mt-5 block">
              <span class="field-label">简介</span>
              <textarea id="settings-bio" class="field min-h-[7rem] resize-y leading-7" placeholder="写字，画画。"></textarea>
            </label>
          </div>

          <div class="card p-5 sm:p-7">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <h2 class="font-display text-2xl font-semibold text-ink dark:text-white">分类</h2>
                <p class="mt-1 text-sm leading-7 text-slate-500 dark:text-slate-400">
                  名称显示在站点上，slug 用于 URL；已有内容的分类不能直接删除或改 slug。
                </p>
              </div>
            </div>
            <div id="settings-categories" class="mt-5 space-y-6"></div>
            <div class="mt-4 flex flex-wrap gap-2">
              <button id="add-post-category" type="button" class="btn-ghost">+ 文章分类</button>
              <button id="add-illustration-category" type="button" class="btn-ghost">+ 插画分类</button>
            </div>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <button id="save-settings" type="button" class="btn-primary">保存设置</button>
          <span id="settings-status" class="text-xs text-slate-400"></span>
        </div>
      </section>
    </section>
  </div>

  <div
    id="toast"
    class="pointer-events-none fixed bottom-5 left-1/2 z-[80] hidden max-w-[calc(100vw-2rem)] -translate-x-1/2 rounded-full bg-ink px-5 py-2.5 text-center text-sm font-medium text-white shadow-2xl dark:bg-white dark:text-ink"
    role="status"
    aria-live="polite"
  ></div>
</BaseLayout>

<script>
  import { parse as parseYaml, stringify as stringifyYaml } from 'yaml';
  import { marked } from 'marked';
  import {
    ILLUSTRATION_CATEGORIES,
    POST_CATEGORIES,
    type Category,
  } from '../data/categories';

  type ItemType = 'posts' | 'illustrations' | 'notes' | 'projects';
  type CategoryItemType = 'posts' | 'illustrations';
  type ViewType = ItemType | 'media' | 'settings';
  type UploadFolder = 'posts' | 'illustrations' | 'projects' | 'site';
  type Item = { type: ItemType; path: string; sha: string; data: Record<string, any>; body: string };
  type MediaFile = { path: string; sha: string };
  type EditableCategory = Category & { originalSlug: string };
  type CategoryGroups = Record<CategoryItemType, EditableCategory[]>;

  const root = document.getElementById('editor-root') as HTMLElement;
  const REPO = root.dataset.repo ?? '';
  const BASE = root.dataset.base ?? '/';
  const TOKEN_KEY = 'yinyiao-editor-token';
  const API = 'https://api.github.com';
  const RAW = `https://raw.githubusercontent.com/${REPO}/main/`;

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => document.getElementById(id) as T;

  let token = localStorage.getItem(TOKEN_KEY) || sessionStorage.getItem(TOKEN_KEY) || '';
  let current: Item | null = null;
  let currentView: ViewType = 'posts';
  let items: Record<ItemType, Item[]> = { posts: [], illustrations: [], notes: [], projects: [] };
  let media: MediaFile[] = [];
  let cover = '';
  let images: string[] = [];

  let postCategories: Category[] = POST_CATEGORIES.map((item) => ({ ...item }));
  let illustrationCategories: Category[] = ILLUSTRATION_CATEGORIES.map((item) => ({ ...item }));
  let profile: Record<string, any> = {};
  let profileSha = '';
  let categoriesSha = '';
  let avatar = '/avatar.svg';
  let settingsInitialized = false;

  function esc(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (char) => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[char] ?? char;
    });
  }

  function today(): string {
    return new Date().toISOString().slice(0, 10);
  }

  function randomId(length = 6): string {
    const alphabet = 'abcdefghijklmnopqrstuvwxyz0123456789';
    const values = crypto.getRandomValues(new Uint8Array(length));
    return Array.from(values, (value) => alphabet[value % alphabet.length]).join('');
  }

  function encodePath(path: string): string {
    return path.split('/').map(encodeURIComponent).join('/');
  }

  function dateString(value: unknown): string {
    if (value instanceof Date) return value.toISOString().slice(0, 10);
    return String(value ?? '').slice(0, 10);
  }

  function formatSize(bytes: number): string {
    if (bytes >= 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(1)}MB`;
    return `${Math.max(1, Math.round(bytes / 1024))}KB`;
  }

  function toBase64(text: string): string {
    const bytes = new TextEncoder().encode(text);
    let binary = '';
    for (const byte of bytes) binary += String.fromCharCode(byte);
    return btoa(binary);
  }

  function fromBase64(value: string): string {
    const binary = atob(value.replace(/\s/g, ''));
    const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
    return new TextDecoder().decode(bytes);
  }

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result).split(',')[1] ?? '');
      reader.onerror = () => reject(new Error('读取文件失败'));
      reader.readAsDataURL(file);
    });
  }

  /**
   * 手机照片往往有 5–10MB，直接 base64 传给 GitHub 又慢又占仓库。
   * 上传前在浏览器里缩到长边 2000px 并转 WebP；GIF/SVG 保持原样。
   */
  async function compressImage(file: File): Promise<File> {
    if (
      !file.type.startsWith('image/') ||
      file.type === 'image/svg+xml' ||
      file.type === 'image/gif'
    ) {
      return file;
    }
    if (file.size <= 350 * 1024) return file;

    try {
      const bitmap = await createImageBitmap(file);
      const maxEdge = 2000;
      const scale = Math.min(1, maxEdge / Math.max(bitmap.width, bitmap.height));
      const width = Math.max(1, Math.round(bitmap.width * scale));
      const height = Math.max(1, Math.round(bitmap.height * scale));

      if (scale === 1 && file.size <= 500 * 1024) {
        bitmap.close();
        return file;
      }

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      if (!ctx) {
        bitmap.close();
        return file;
      }
      ctx.drawImage(bitmap, 0, 0, width, height);
      bitmap.close();

      const blob = await new Promise<Blob | null>((resolve) => {
        canvas.toBlob(resolve, 'image/webp', 0.82);
      });
      if (!blob || blob.size >= file.size) return file;

      const stem = file.name.replace(/\.[^.]+$/, '') || 'image';
      // 某些 Safari 版本不支持 WebP 编码，会回退成 PNG；扩展名必须跟真实类型一致。
      const extension =
        blob.type === 'image/webp' ? 'webp' : blob.type === 'image/jpeg' ? 'jpg' : 'png';
      return new File([blob], `${stem}.${extension}`, {
        type: blob.type || 'image/png',
        lastModified: Date.now(),
      });
    } catch {
      // 老浏览器不支持 createImageBitmap 时，回退到原图。
      return file;
    }
  }

  function fromPublic(path: string): string {
    if (!path) return '';
    if (/^(https?:)?\/\//.test(path) || path.startsWith('data:')) return path;
    if (path.startsWith('public/')) return path;
    return `public${path.startsWith('/') ? '' : '/'}${path}`;
  }

  function publicPath(path: string): string {
    return path.startsWith('public/') ? `/${path.slice(7)}` : path;
  }

  function imageSrc(path: string): string {
    if (!path) return '';
    if (/^(https?:)?\/\//.test(path) || path.startsWith('data:')) return path;
    const repoPath = fromPublic(path);
    return `${RAW}${encodePath(repoPath)}`;
  }

  function parseTags(value: string): string[] {
    return Array.from(
      new Set(
        value
          .split(/[,，、]/)
          .map((tag) => tag.trim())
          .filter(Boolean),
      ),
    );
  }

  function parseContent(raw: string): { data: Record<string, any>; body: string } {
    const match = raw.replace(/^\uFEFF/, '').match(/^---\s*\r?\n([\s\S]*?)\r?\n---\s*\r?\n?([\s\S]*)$/);
    if (!match) return { data: {}, body: raw };
    try {
      return { data: (parseYaml(match[1]) as Record<string, any>) ?? {}, body: match[2] ?? '' };
    } catch {
      return { data: {}, body: match[2] ?? '' };
    }
  }

  function setStatus(text: string): void {
    $('editor-status').textContent = text;
  }

  let toastTimer: number | undefined;
  function toast(message: string, type: 'info' | 'error' = 'info'): void {
    const el = $('toast');
    el.textContent = message;
    el.classList.remove('hidden', 'bg-ink', 'dark:bg-white', 'bg-red-600', 'dark:bg-red-500');
    if (type === 'error') {
      el.classList.add('bg-red-600', 'dark:bg-red-500');
    } else {
      el.classList.add('bg-ink', 'dark:bg-white');
    }
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => el.classList.add('hidden'), type === 'error' ? 6000 : 3200);
  }

  async function gh(path: string, init: RequestInit = {}): Promise<any> {
    const headers: Record<string, string> = {
      Accept: 'application/vnd.github+json',
      'X-GitHub-Api-Version': '2022-11-28',
      Authorization: `Bearer ${token}`,
    };
    if (init.body) headers['Content-Type'] = 'application/json';

    const response = await fetch(`${API}${path}`, { ...init, headers });
    if (!response.ok) {
      let message = `${response.status} ${response.statusText}`;
      try {
        const payload = await response.json();
        if (payload?.message) message = payload.message;
      } catch {
        /* keep status text */
      }
      if (response.status === 401) message = 'Token 无效或已过期，请重新生成后登录。';
      if (response.status === 403) message = `没有权限：${message}`;
      if (response.status === 404) message = '找不到仓库或文件；请确认 Token 有 Contents 读写权限。';
      throw new Error(message);
    }
    if (response.status === 204) return null;
    return response.json();
  }

  async function readContent(path: string): Promise<Item> {
    const file = await gh(`/repos/${REPO}/contents/${encodePath(path)}?ref=main`);
    const raw = fromBase64(file.content);
    const parsed = parseContent(raw);
    const type: ItemType = path.startsWith('src/content/posts/')
      ? 'posts'
      : path.startsWith('src/content/notes/')
        ? 'notes'
        : path.startsWith('src/content/projects/')
          ? 'projects'
          : 'illustrations';
    return { type, path, sha: file.sha, data: parsed.data, body: parsed.body };
  }

  async function readJsonFile(path: string): Promise<{ data: any; sha: string } | null> {
    try {
      const file = await gh(`/repos/${REPO}/contents/${encodePath(path)}?ref=main`);
      return { data: JSON.parse(fromBase64(file.content)), sha: file.sha };
    } catch {
      return null;
    }
  }

  function normalizeCategories(value: any): Category[] {
    if (!Array.isArray(value)) return [];
    return value
      .map((item) => ({
        slug: String(item?.slug ?? '').trim(),
        label: String(item?.label ?? '').trim(),
        description: String(item?.description ?? '').trim(),
      }))
      .filter((item) => item.slug && item.label);
  }

  async function commitFiles(
    files: { path: string; content: string }[],
    message: string,
  ): Promise<Record<string, string>> {
    const ref = await gh(`/repos/${REPO}/git/ref/heads/main`);
    const headSha = ref.object.sha;
    const head = await gh(`/repos/${REPO}/git/commits/${headSha}`);
    const blobs: Record<string, string> = {};

    for (const file of files) {
      const blob = await gh(`/repos/${REPO}/git/blobs`, {
        method: 'POST',
        body: JSON.stringify({ content: toBase64(file.content), encoding: 'base64' }),
      });
      blobs[file.path] = blob.sha;
    }

    const tree = await gh(`/repos/${REPO}/git/trees`, {
      method: 'POST',
      body: JSON.stringify({
        base_tree: head.tree.sha,
        tree: files.map((file) => ({
          path: file.path,
          mode: '100644',
          type: 'blob',
          sha: blobs[file.path],
        })),
      }),
    });
    const commit = await gh(`/repos/${REPO}/git/commits`, {
      method: 'POST',
      body: JSON.stringify({ message, tree: tree.sha, parents: [headSha] }),
    });
    await gh(`/repos/${REPO}/git/refs/heads/main`, {
      method: 'PATCH',
      body: JSON.stringify({ sha: commit.sha }),
    });
    return blobs;
  }

  async function loadData(selectPath?: string): Promise<void> {
    setStatus('读取仓库…');
    const tree = await gh(`/repos/${REPO}/git/trees/main?recursive=1`);
    const [profileFile, categoriesFile] = await Promise.all([
      readJsonFile('config/site.json'),
      readJsonFile('config/categories.json'),
    ]);

    if (profileFile) {
      profile =
        profileFile.data && typeof profileFile.data === 'object' && !Array.isArray(profileFile.data)
          ? profileFile.data
          : {};
      profileSha = profileFile.sha;
      avatar = String(profile.avatar || avatar);
    }
    if (categoriesFile) {
      const posts = normalizeCategories(categoriesFile.data?.posts);
      const illustrations = normalizeCategories(categoriesFile.data?.illustrations);
      if (posts.length) postCategories = posts;
      if (illustrations.length) illustrationCategories = illustrations;
      categoriesSha = categoriesFile.sha;
    }
    const blobs = (tree.tree ?? []).filter((node: any) => node.type === 'blob') as any[];

    media = blobs
      .filter((node) => node.path.startsWith('public/uploads/') && /\.(avif|gif|jpe?g|png|svg|webp)$/i.test(node.path))
      .map((node) => ({ path: node.path, sha: node.sha }));

    const paths = blobs
      .filter((node) => /^src\/content\/(posts|illustrations|notes|projects)\/.+\.md$/.test(node.path))
      .map((node) => node.path);

    const loaded = await Promise.all(paths.map((path) => readContent(path)));
    const byDate = (type: ItemType) =>
      loaded
        .filter((item) => item.type === type)
        .sort((a, b) => dateString(b.data.date).localeCompare(dateString(a.data.date)));
    items = {
      posts: byDate('posts'),
      illustrations: byDate('illustrations'),
      notes: byDate('notes'),
      projects: byDate('projects'),
    };

    renderList();
    renderMedia();
    settingsInitialized = false;

    const targetPath = selectPath || current?.path;
    if (targetPath) {
      const found = Object.values(items).flat().find((item) => item.path === targetPath);
      if (found) selectItem(found);
      else resetForm();
    } else {
      resetForm();
    }

    setStatus(
      `${items.posts.length} 篇文章 · ${items.illustrations.length} 幅插画 · ${items.notes.length} 条说说 · ${items.projects.length} 个项目 · ${media.length} 张图片`,
    );
    if (currentView === 'settings') {
      renderSettings();
      settingsInitialized = true;
    }
  }

  function syncTabs(): void {
    document.querySelectorAll<HTMLElement>('[data-view]').forEach((button) => {
      button.classList.toggle('editor-tab-active', button.dataset.view === currentView);
    });
    const isMedia = currentView === 'media';
    const isSettings = currentView === 'settings';
    $('content-workspace').classList.toggle('hidden', isMedia || isSettings);
    $('media-view').classList.toggle('hidden', !isMedia);
    $('settings-view').classList.toggle('hidden', !isSettings);
    for (const id of ['new-post', 'new-illustration', 'new-note', 'new-project']) {
      $(id).classList.toggle('hidden', isMedia || isSettings);
    }

    if (isSettings) {
      if (!settingsInitialized) {
        renderSettings();
        settingsInitialized = true;
      }
      return;
    }
    if (!isMedia) {
      const titles: Record<ItemType, string> = {
        posts: '文章',
        illustrations: '插画',
        notes: '说说',
        projects: '项目',
      };
      $('list-title').textContent = titles[currentView];
      $('list-count').textContent = `${items[currentView].length}`;
      renderList();
    }
  }

  function renderList(): void {
    if (currentView === 'media' || currentView === 'settings') return;
    const list = items[currentView];
    const container = $('item-list');
    if (!list.length) {
      container.innerHTML =
        '<p class="px-3 py-8 text-center text-sm text-slate-400">还没有内容，点右上角新建。</p>';
      return;
    }

    container.innerHTML = list
      .map((item) => {
        const active = current?.path === item.path;
        const title = esc(item.data.title || (item.type === 'notes' ? '无题' : '未命名'));
        const date = esc(dateString(item.data.date));
        const draft = item.data.draft ? '<span class="text-amber-500">草稿</span>' : '';
        return `<button type="button" data-path="${esc(item.path)}" data-type="${item.type}" class="w-full rounded-xl border px-3 py-3 text-left transition ${
          active
            ? 'border-rose-200 bg-rose-50/80 dark:border-rose-300/30 dark:bg-rose-400/10'
            : 'border-transparent hover:border-slate-200/80 hover:bg-white/60 dark:hover:border-white/10 dark:hover:bg-white/5'
        }">
          <span class="block truncate text-sm font-medium text-ink dark:text-slate-100">${title}</span>
          <span class="mt-1 flex items-center gap-2 text-[0.7rem] text-slate-400"><span>${date}</span>${draft}</span>
        </button>`;
      })
      .join('');
  }

  function renderMedia(): void {
    const grid = $('media-grid');
    if (!media.length) {
      grid.innerHTML =
        '<p class="col-span-full py-12 text-center text-sm text-slate-400">媒体库还是空的，上传第一张图片吧。</p>';
      return;
    }

    grid.innerHTML = media
      .map((file) => {
        const name = file.path.split('/').pop() ?? file.path;
        return `<figure class="group overflow-hidden rounded-xl border border-slate-200/70 bg-white/60 dark:border-white/10 dark:bg-white/5">
          <img src="${imageSrc(file.path)}" alt="${esc(name)}" loading="lazy" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="space-y-2 p-2.5">
            <p class="truncate font-mono text-[0.65rem] text-slate-400" title="${esc(name)}">${esc(name)}</p>
            <div class="flex flex-wrap gap-1">
              <button type="button" data-media-action="cover" data-path="${esc(file.path)}" class="rounded-full bg-rose-50 px-2 py-1 text-[0.65rem] text-rose-600 hover:bg-rose-100 dark:bg-rose-400/10 dark:text-rose-200">封面</button>
              <button type="button" data-media-action="avatar" data-path="${esc(file.path)}" class="rounded-full bg-amber-50 px-2 py-1 text-[0.65rem] text-amber-600 hover:bg-amber-100 dark:bg-amber-400/10 dark:text-amber-200">头像</button>
              <button type="button" data-media-action="insert" data-path="${esc(file.path)}" class="rounded-full bg-violet-50 px-2 py-1 text-[0.65rem] text-violet-600 hover:bg-violet-100 dark:bg-violet-400/10 dark:text-violet-200">插画</button>
              <button type="button" data-media-action="copy" data-path="${esc(file.path)}" class="rounded-full bg-slate-100 px-2 py-1 text-[0.65rem] text-slate-500 hover:bg-slate-200 dark:bg-white/10 dark:text-slate-300">路径</button>
              <button type="button" data-media-action="delete" data-path="${esc(file.path)}" class="rounded-full bg-red-50 px-2 py-1 text-[0.65rem] text-red-500 hover:bg-red-100 dark:bg-red-400/10 dark:text-red-300">删除</button>
            </div>
          </figcaption>
        </figure>`;
      })
      .join('');
  }

  function renderAvatarPreview(): void {
    const preview = $<HTMLImageElement>('settings-avatar-preview');
    const placeholder = $('settings-avatar-placeholder');
    if (avatar) {
      preview.src = imageSrc(avatar);
      preview.classList.remove('hidden');
      placeholder.classList.add('hidden');
    } else {
      preview.removeAttribute('src');
      preview.classList.add('hidden');
      placeholder.classList.remove('hidden');
    }
  }

  function renderCategoryGroup(type: CategoryItemType): string {
    const list = categoriesFor(type);
    const title = type === 'posts' ? '文章分类' : '插画分类';
    return `<section>
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-sm font-semibold text-ink dark:text-slate-100">${title}</h3>
        <span class="text-[0.7rem] text-slate-400">${list.length} 个</span>
      </div>
      <div class="mt-2 space-y-2" data-category-list="${type}">
        ${list
          .map(
            (item) => `<div class="rounded-xl border border-slate-200/70 bg-white/60 p-3 dark:border-white/10 dark:bg-white/5" data-category-row data-category-type="${type}" data-original-slug="${esc(item.slug)}">
              <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]">
                <label class="block"><span class="field-label">名称</span><input class="field py-2 text-xs" data-cat-field="label" value="${esc(item.label)}" placeholder="例如：随笔" /></label>
                <label class="block"><span class="field-label">slug</span><input class="field py-2 font-mono text-xs" data-cat-field="slug" value="${esc(item.slug)}" placeholder="essay" /></label>
                <button type="button" class="btn-ghost self-end px-3 py-2 text-xs text-red-500" data-remove-category>移除</button>
              </div>
              <label class="mt-2 block"><span class="field-label">描述（可选，显示在关于页）</span><input class="field py-2 text-xs" data-cat-field="description" value="${esc(item.description)}" placeholder="一句话说明这个分类" /></label>
            </div>`,
          )
          .join('')}
      </div>
    </section>`;
  }

  function renderCategoryRows(): void {
    $('settings-categories').innerHTML = `${renderCategoryGroup('posts')}${renderCategoryGroup('illustrations')}`;
  }

  function renderAvatarMediaOptions(): void {
    const select = $<HTMLSelectElement>('settings-avatar-media');
    select.innerHTML = `<option value="">从媒体库选择…</option>${media
      .map((file) => {
        const value = publicPath(file.path);
        const name = file.path.split('/').pop() ?? file.path;
        return `<option value="${esc(value)}">${esc(name)}</option>`;
      })
      .join('')}`;
    select.value = media.some((file) => publicPath(file.path) === avatar) ? avatar : '';
  }

  function renderSettings(): void {
    $<HTMLInputElement>('settings-avatar').value = avatar;
    renderAvatarPreview();
    $<HTMLTextAreaElement>('settings-bio').value = String(profile.bio ?? '');
    renderAvatarMediaOptions();
    renderCategoryRows();
  }

  function addCategory(type: CategoryItemType): void {
    categoriesFor(type).push({ slug: '', label: '', description: '' });
    renderCategoryRows();
    const rows = document.querySelectorAll<HTMLElement>(`[data-category-type="${type}"]`);
    rows.item(rows.length - 1)?.querySelector<HTMLInputElement>('[data-cat-field="label"]')?.focus();
  }

  function collectCategories(): CategoryGroups {
    const groups: CategoryGroups = { posts: [], illustrations: [] };
    document.querySelectorAll<HTMLElement>('[data-category-row]').forEach((row) => {
      const type = (row.dataset.categoryType as CategoryItemType) || 'posts';
      const get = (field: string) =>
        row.querySelector<HTMLInputElement>(`[data-cat-field="${field}"]`)?.value.trim() ?? '';
      groups[type].push({
        slug: get('slug').toLowerCase(),
        label: get('label'),
        description: get('description'),
        originalSlug: row.dataset.originalSlug ?? '',
      });
    });
    return groups;
  }

  function usedCategoryCount(type: ItemType, slug: string): number {
    return items[type].filter((item) => item.data.category === slug).length;
  }

  function validateCategories(groups: CategoryGroups): string {
    for (const type of ['posts', 'illustrations'] as CategoryItemType[]) {
      const list = groups[type];
      if (!list.length) return `${type === 'posts' ? '文章' : '插画'}至少需要保留一个分类。`;

      const slugs = new Set<string>();
      for (const item of list) {
        if (!item.label || !item.slug) return '分类名称和 slug 都不能为空。';
        if (!/^[a-z0-9-]+$/.test(item.slug)) {
          return `分类 slug「${item.slug}」只能包含小写字母、数字和连字符。`;
        }
        if (slugs.has(item.slug)) return `分类 slug「${item.slug}」重复了。`;
        slugs.add(item.slug);
      }

      for (const previous of categoriesFor(type)) {
        const row = list.find((item) => item.originalSlug === previous.slug);
        const removedOrRenamed = !row || row.slug !== previous.slug;
        if (removedOrRenamed) {
          const count = usedCategoryCount(type, previous.slug);
          if (count > 0) {
            return `分类「${previous.label}」下还有 ${count} 篇内容，不能删除或改 slug。`;
          }
        }
      }
    }
    return '';
  }

  function cleanGroups(groups: CategoryGroups): Record<CategoryItemType, Category[]> {
    const clean = (list: EditableCategory[]): Category[] =>
      list.map(({ slug, label, description }) => ({ slug, label, description }));
    return { posts: clean(groups.posts), illustrations: clean(groups.illustrations) };
  }

  async function saveSettings(): Promise<void> {
    const groups = collectCategories();
    const error = validateCategories(groups);
    if (error) {
      toast(error, 'error');
      $('settings-status').textContent = error;
      return;
    }

    const cleaned = cleanGroups(groups);
    const nextProfile = {
      ...(profile || {}),
      avatar: avatar.trim() || '/avatar.svg',
      bio: $<HTMLTextAreaElement>('settings-bio').value.trim(),
    };
    const files = [
      {
        path: 'config/site.json',
        content: `${JSON.stringify(nextProfile, null, 2)}\n`,
      },
      {
        path: 'config/categories.json',
        content: `${JSON.stringify(cleaned, null, 2)}\n`,
      },
    ];

    try {
      $<HTMLButtonElement>('save-settings').disabled = true;
      $('settings-status').textContent = '正在提交…';
      const shas = await commitFiles(files, 'settings: update profile and categories');
      profile = nextProfile;
      avatar = nextProfile.avatar;
      postCategories = cleaned.posts;
      illustrationCategories = cleaned.illustrations;
      profileSha = shas['config/site.json'] || profileSha;
      categoriesSha = shas['config/categories.json'] || categoriesSha;
      renderSettings();
      $('settings-status').textContent = '已提交，构建中';
      toast('设置已提交，GitHub Actions 约 40–60 秒后发布；页面会自动刷新。');
    } catch (cause) {
      const message = cause instanceof Error ? cause.message : String(cause);
      $('settings-status').textContent = message;
      toast(message, 'error');
    } finally {
      $<HTMLButtonElement>('save-settings').disabled = false;
    }
  }

  function categoriesFor(type: ItemType): Category[] {
    if (type === 'posts') return postCategories;
    if (type === 'illustrations') return illustrationCategories;
    return [];
  }

  function fillCategoryOptions(type: ItemType, selected?: string): void {
    if (type !== 'posts' && type !== 'illustrations') return;
    const list = categoriesFor(type);
    const select = $<HTMLSelectElement>('field-category');
    select.innerHTML = list
      .map((item) => `<option value="${esc(item.slug)}">${esc(item.label)}</option>`)
      .join('');
    const fallback = list[0]?.slug ?? '';
    select.value = list.some((item) => item.slug === selected) ? (selected as string) : fallback;
  }

  function renderCover(): void {
    const preview = $<HTMLImageElement>('cover-preview');
    const placeholder = $('cover-placeholder');
    if (cover) {
      preview.src = imageSrc(cover);
      preview.classList.remove('hidden');
      placeholder.classList.add('hidden');
    } else {
      preview.removeAttribute('src');
      preview.classList.add('hidden');
      placeholder.classList.remove('hidden');
    }
    $<HTMLInputElement>('field-cover').value = cover;
  }

  function renderImages(): void {
    const container = $('illustration-images');
    if (!images.length) {
      container.innerHTML =
        '<p class="col-span-full rounded-xl border border-dashed border-slate-200/80 px-3 py-8 text-center text-xs text-slate-400 dark:border-white/10">还没有图片，点“上传图片”选择相册或拍照。</p>';
      return;
    }

    container.innerHTML = images
      .map(
        (src, index) => `<div class="group relative overflow-hidden rounded-xl border border-slate-200/70 bg-white/60 dark:border-white/10 dark:bg-white/5">
          <img src="${imageSrc(src)}" alt="插画 ${index + 1}" class="aspect-[4/3] w-full object-cover" />
          <button type="button" data-remove-image="${index}" class="absolute right-1.5 top-1.5 rounded-full bg-black/55 px-2 py-1 text-[0.65rem] text-white backdrop-blur hover:bg-red-600">移除</button>
        </div>`,
      )
      .join('');
  }

  function fillForm(item: Item): void {
    current = item;
    currentView = item.type;
    syncTabs();

    const data = item.data;
    const titleInput = $<HTMLInputElement>('field-title');
    $<HTMLInputElement>('field-type').value = item.type;
    titleInput.value = String(data.title ?? '');
    titleInput.required = item.type !== 'notes';
    titleInput.placeholder =
      item.type === 'notes'
        ? '可以留空，只写一段话'
        : item.type === 'projects'
          ? '项目名称'
          : '给这篇内容起一个名字';
    $<HTMLInputElement>('field-date').value = dateString(data.date) || today();
    fillCategoryOptions(item.type, String(data.category ?? ''));
    $('category-field').classList.toggle('hidden', item.type === 'notes' || item.type === 'projects');
    $<HTMLInputElement>('field-tags').value = Array.isArray(data.tags) ? data.tags.join(', ') : String(data.tags ?? '');
    $<HTMLInputElement>('field-draft').checked = Boolean(data.draft);
    $<HTMLInputElement>('field-cover').placeholder =
      item.type === 'projects' ? '/uploads/projects/...' : '/uploads/posts/...';

    cover = typeof data.cover === 'string' ? data.cover : '';
    images = Array.isArray(data.images) ? data.images.map(String) : [];
    $<HTMLTextAreaElement>('field-summary').value = String(data.summary ?? '');
    $<HTMLInputElement>('field-link').value = String(data.link ?? '');
    $<HTMLInputElement>('field-repo').value = String(data.repo ?? '');
    $<HTMLInputElement>('field-featured').checked = Boolean(data.featured);

    const isWriting = item.type === 'posts' || item.type === 'notes' || item.type === 'projects';
    $('post-fields').classList.toggle('hidden', !isWriting);
    $('illustration-fields').classList.toggle('hidden', item.type !== 'illustrations');
    $('project-fields').classList.toggle('hidden', item.type !== 'projects');
    $('cover-block').classList.toggle('hidden', item.type === 'notes');
    $<HTMLTextAreaElement>('field-body').value = isWriting ? item.body : '';
    $<HTMLTextAreaElement>('field-description').value = String(data.description ?? '');

    renderCover();
    renderImages();

    $('form-empty').classList.add('hidden');
    $('content-form').classList.remove('hidden');
    $('delete-button').classList.toggle('hidden', !item.path);
    $('save-button').textContent = item.path ? '保存修改' : '保存并发布';
    $('preview-panel').classList.add('hidden');
    renderList();
  }

  function selectItem(item: Item): void {
    fillForm(item);
  }

  function selectByPath(type: ItemType, path: string): void {
    const item = items[type].find((entry) => entry.path === path);
    if (item) selectItem(item);
  }

  function newItem(type: ItemType): void {
    const base: Record<string, any> = { title: '', date: today(), tags: [], draft: false };
    if (type === 'posts' || type === 'illustrations') {
      base.category = categoriesFor(type)[0]?.slug ?? 'uncategorized';
    }
    if (type === 'projects') {
      base.summary = '';
      base.link = '';
      base.repo = '';
      base.featured = false;
    }
    current = { type, path: '', sha: '', data: base, body: '' };
    cover = '';
    images = [];
    fillForm(current);
    $<HTMLInputElement>('field-title').focus();
  }

  function resetForm(): void {
    current = null;
    $('content-form').classList.add('hidden');
    $('form-empty').classList.remove('hidden');
    $('preview-panel').classList.add('hidden');
    renderList();
  }

  function collect(): { type: ItemType; data: Record<string, any>; body: string } | null {
    if (!current) return null;
    const type = current.type;
    const title = $<HTMLInputElement>('field-title').value.trim();
    const date = $<HTMLInputElement>('field-date').value;
    const category = $<HTMLSelectElement>('field-category').value;
    const tags = parseTags($<HTMLInputElement>('field-tags').value);
    const draft = $<HTMLInputElement>('field-draft').checked;
    const body = $<HTMLTextAreaElement>('field-body').value;

    if (type !== 'notes' && !title) {
      toast(type === 'projects' ? '请先写项目名称。' : '请先写标题。', 'error');
      return null;
    }
    if (!date) {
      toast('请选择日期。', 'error');
      return null;
    }

    if (type === 'posts') {
      const data: Record<string, any> = { title, date, category, tags };
      if (cover.trim()) data.cover = cover.trim();
      data.draft = draft;
      return { type, data, body };
    }

    if (type === 'notes') {
      const data: Record<string, any> = { date, tags, draft };
      if (title) data.title = title;
      return { type, data, body };
    }

    if (type === 'projects') {
      const data: Record<string, any> = {
        title,
        date,
        summary: $<HTMLTextAreaElement>('field-summary').value.trim(),
        tags,
        link: $<HTMLInputElement>('field-link').value.trim(),
        repo: $<HTMLInputElement>('field-repo').value.trim(),
        featured: $<HTMLInputElement>('field-featured').checked,
        draft,
      };
      if (cover.trim()) data.cover = cover.trim();
      return { type, data, body };
    }

    if (!images.length) {
      toast('插画至少需要一张图片。', 'error');
      return null;
    }
    const data: Record<string, any> = {
      title,
      date,
      category,
      tags,
      images: [...images],
      description: $<HTMLTextAreaElement>('field-description').value.trim(),
      draft,
    };
    return { type, data, body: '' };
  }

  function makeSlug(title: string): string {
    const ascii = title
      .normalize('NFKD')
      .replace(/[^\w\s-]/g, '')
      .trim()
      .toLowerCase()
      .replace(/[\s_]+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '')
      .slice(0, 40);
    return ascii || 'entry';
  }

  async function save(): Promise<void> {
    if (!current) return;
    const collected = collect();
    if (!collected) return;

    const label = String(collected.data.title ?? '').trim() || collected.data.date;
    const targetPath =
      current.path ||
      `src/content/${collected.type}/${collected.data.date}-${makeSlug(String(collected.data.title ?? ''))}-${randomId()}.md`;
    const yaml = stringifyYaml(collected.data, { lineWidth: 0 });
    const content = `---\n${yaml}---\n\n${collected.body.trim()}\n`;

    const payload: Record<string, any> = {
      message: `${current.path ? 'update' : 'create'} ${collected.type}: ${label}`,
      content: toBase64(content),
      branch: 'main',
    };
    if (current.sha) payload.sha = current.sha;

    try {
      setStatus('正在提交…');
      $<HTMLButtonElement>('save-button').disabled = true;
      const response = await gh(`/repos/${REPO}/contents/${encodePath(targetPath)}`, {
        method: 'PUT',
        body: JSON.stringify(payload),
      });

      // GitHub 的 git/trees 偶尔会短暂返回旧结果；先本地合并，避免刚保存的内容从列表里消失。
      const saved: Item = {
        type: collected.type,
        path: targetPath,
        sha: response?.content?.sha ?? current.sha,
        data: collected.data,
        body: collected.body,
      };
      items[collected.type] = [
        ...items[collected.type].filter((entry) => entry.path !== targetPath),
        saved,
      ].sort((a, b) => dateString(b.data.date).localeCompare(dateString(a.data.date)));
      current = saved;
      fillForm(saved);
      setStatus(
        `${items.posts.length} 篇文章 · ${items.illustrations.length} 幅插画 · ${items.notes.length} 条说说 · ${items.projects.length} 个项目 · ${media.length} 张图片`,
      );
      toast('已提交，GitHub Actions 约 40–60 秒后发布；页面会自动刷新。');
    } catch (error) {
      toast(error instanceof Error ? error.message : String(error), 'error');
    } finally {
      $<HTMLButtonElement>('save-button').disabled = false;
    }
  }

  async function removeCurrent(): Promise<void> {
    if (!current?.path || !current.sha) {
      toast('这篇内容还没有保存过。', 'error');
      return;
    }
    if (!confirm(`确定删除《${current.data.title || '未命名'}》？这会同时删除仓库里的 Markdown 文件。`)) return;

    try {
      setStatus('正在删除…');
      await gh(`/repos/${REPO}/contents/${encodePath(current.path)}`, {
        method: 'DELETE',
        body: JSON.stringify({
          message: `delete ${current.type}: ${current.data.title || current.path}`,
          sha: current.sha,
          branch: 'main',
        }),
      });
      const removedType = current.type;
      items[removedType] = items[removedType].filter((entry) => entry.path !== current?.path);
      current = null;
      resetForm();
      setStatus(
        `${items.posts.length} 篇文章 · ${items.illustrations.length} 幅插画 · ${items.notes.length} 条说说 · ${items.projects.length} 个项目 · ${media.length} 张图片`,
      );
      toast('已删除。');
    } catch (error) {
      toast(error instanceof Error ? error.message : String(error), 'error');
    }
  }

  async function uploadFiles(files: FileList | File[], folder: UploadFolder, target: 'cover' | 'images' | 'media' | 'avatar'): Promise<void> {
    const list = Array.from(files);
    if (!list.length) return;

    for (const file of list) {
      if (!file.type.startsWith('image/')) {
        toast(`跳过非图片文件：${file.name}`, 'error');
        continue;
      }
      if (file.size > 30 * 1024 * 1024) {
        toast(`图片超过 30MB，请先裁剪或压缩：${file.name}`, 'error');
        continue;
      }

      try {
        setStatus(`处理 ${file.name}…`);
        const upload = await compressImage(file);
        if (upload.size > 8 * 1024 * 1024) {
          toast(`压缩后仍超过 8MB，请先裁剪：${file.name}`, 'error');
          continue;
        }

        const extension =
          (upload.name.split('.').pop() || 'png').toLowerCase().replace(/[^a-z0-9]/g, '') || 'png';
        const stem =
          upload.name
            .replace(/\.[^.]+$/, '')
            .replace(/[^\w-]+/g, '-')
            .replace(/^-+|-+$/g, '')
            .slice(0, 36) || 'image';
        const path = `public/uploads/${folder}/${today().replace(/-/g, '')}-${randomId(5)}-${stem}.${extension}`;

        setStatus(`上传 ${file.name}…`);
        const response = await gh(`/repos/${REPO}/contents/${encodePath(path)}`, {
          method: 'PUT',
          body: JSON.stringify({
            message: `upload: ${file.name} [skip ci]`,
            content: await fileToBase64(upload),
            branch: 'main',
          }),
        });
        media.push({ path, sha: response.content.sha });
        const value = publicPath(path);
        if (target === 'cover') {
          cover = value;
          renderCover();
        } else if (target === 'images') {
          images.push(value);
          renderImages();
        } else if (target === 'avatar') {
          avatar = value;
          $<HTMLInputElement>('settings-avatar').value = value;
          renderAvatarPreview();
          renderAvatarMediaOptions();
        }
        renderMedia();
        toast(
          upload === file
            ? `已上传：${file.name}`
            : `已压缩并上传：${formatSize(file.size)} → ${formatSize(upload.size)}`,
        );
      } catch (error) {
        toast(error instanceof Error ? error.message : String(error), 'error');
      }
    }
    setStatus('上传完成');
  }

  async function removeMedia(path: string): Promise<void> {
    const file = media.find((entry) => entry.path === path);
    if (!file) return;
    const value = publicPath(path);
    const usedBy = Object.values(items).flat().filter((item) => JSON.stringify(item.data).includes(value));
    const name = path.split('/').pop() || path;
    const message = usedBy.length
      ? `这张图正在被 ${usedBy.map((item) => `《${item.data.title || '未命名'}》`).join('、')} 使用，仍然删除？`
      : `确定删除 ${name}？`;
    if (!confirm(message)) return;

    try {
      await gh(`/repos/${REPO}/contents/${encodePath(path)}`, {
        method: 'DELETE',
        body: JSON.stringify({ message: `delete image: ${name}`, sha: file.sha, branch: 'main' }),
      });
      media = media.filter((entry) => entry.path !== path);
      if (cover === value) {
        cover = '';
        renderCover();
      }
      images = images.filter((entry) => entry !== value);
      if (avatar === value) {
        avatar = '/avatar.svg';
        $<HTMLInputElement>('settings-avatar').value = avatar;
        renderAvatarPreview();
      }
      renderImages();
      renderMedia();
      renderAvatarMediaOptions();
      toast('图片已删除。');
    } catch (error) {
      toast(error instanceof Error ? error.message : String(error), 'error');
    }
  }

  function preserveMarkdownIndent(markdown: string): string {
    let inFence = false;
    let previousBlank = true;
    return markdown
      .split('\n')
      .map((line) => {
        if (/^\s*(```|~~~)/.test(line)) {
          inFence = !inFence;
          previousBlank = false;
          return line;
        }
        if (inFence) {
          previousBlank = line.trim() === '';
          return line;
        }
        const match = line.match(/^[ \t]+/);
        if (match) {
          const width = match[0].replace(/\t/g, '    ').length;
          const rest = line.slice(match[0].length);
          const isMarkdownSyntax = /^([-*+]|\d+\.)\s/.test(rest) || rest.startsWith('>');
          const isIndentedCode = width >= 4 && previousBlank;
          if (!isMarkdownSyntax && !isIndentedCode) line = '\u00a0'.repeat(width) + rest;
        }
        previousBlank = line.trim() === '';
        return line;
      })
      .join('\n');
  }

  function sanitizeHtml(html: string): string {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    doc.querySelectorAll('script,iframe,object,embed,link,meta,style,form').forEach((node) => node.remove());
    doc.querySelectorAll('*').forEach((element) => {
      for (const attribute of [...element.attributes]) {
        if (/^on/i.test(attribute.name) || attribute.name === 'srcdoc') element.removeAttribute(attribute.name);
        if ((attribute.name === 'href' || attribute.name === 'src') && /^\s*javascript:/i.test(attribute.value)) {
          element.removeAttribute(attribute.name);
        }
      }
    });
    doc.querySelectorAll<HTMLImageElement>('img[src^="/uploads/"]').forEach((image) => {
      image.src = BASE + (image.getAttribute('src') ?? '').slice(1);
    });
    return doc.body.innerHTML;
  }

  function togglePreview(): void {
    const panel = $('preview-panel');
    if (!panel.classList.contains('hidden')) {
      panel.classList.add('hidden');
      return;
    }
    if (!current) return;

    const content = $('preview-content');
    if (current.type === 'posts' || current.type === 'notes' || current.type === 'projects') {
      const markdown = $<HTMLTextAreaElement>('field-body').value;
      content.innerHTML = `<article class="prose prose-sm prose-custom max-w-none dark:prose-invert">${sanitizeHtml(
        String(marked.parse(preserveMarkdownIndent(markdown))),
      )}</article>`;
    } else {
      const description = $<HTMLTextAreaElement>('field-description').value.trim();
      content.innerHTML = `<div class="space-y-4">
        ${description ? `<p class="whitespace-pre-wrap text-sm leading-7 text-slate-600 dark:text-slate-300">${esc(description)}</p>` : ''}
        <div class="grid grid-cols-2 gap-3">${images
          .map((src) => `<img src="${imageSrc(src)}" alt="插画预览" class="w-full rounded-xl object-cover" />`)
          .join('')}</div>
      </div>`;
    }
    panel.classList.remove('hidden');
  }

  function copyPath(path: string): void {
    const value = publicPath(path);
    navigator.clipboard
      ?.writeText(value)
      .then(() => toast(`已复制：${value}`))
      .catch(() => toast(value));
  }

  function showAuth(): void {
    $('auth-panel').classList.remove('hidden');
    $('app-panel').classList.add('hidden');
    $('logout-button').classList.add('hidden');
  }

  function showApp(): void {
    $('auth-panel').classList.add('hidden');
    $('app-panel').classList.remove('hidden');
    $('logout-button').classList.remove('hidden');
  }

  async function connect(value: string, remember: boolean): Promise<boolean> {
    token = value.trim();
    if (!token) {
      $('auth-status').textContent = '请先粘贴 Token。';
      return false;
    }

    $('auth-status').textContent = '验证中…';
    $<HTMLButtonElement>('auth-submit').disabled = true;
    try {
      await gh(`/repos/${REPO}`);
      if (remember) {
        localStorage.setItem(TOKEN_KEY, token);
        sessionStorage.removeItem(TOKEN_KEY);
      } else {
        sessionStorage.setItem(TOKEN_KEY, token);
        localStorage.removeItem(TOKEN_KEY);
      }
      showApp();
      $('auth-status').textContent = '';
      await loadData();
      return true;
    } catch (error) {
      token = '';
      $('auth-status').textContent = error instanceof Error ? error.message : String(error);
      showAuth();
      return false;
    } finally {
      $<HTMLButtonElement>('auth-submit').disabled = false;
    }
  }

  function bindEvents(): void {
    $('auth-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      await connect($<HTMLInputElement>('token-input').value, $<HTMLInputElement>('remember-token').checked);
    });

    $('logout-button').addEventListener('click', () => {
      token = '';
      localStorage.removeItem(TOKEN_KEY);
      sessionStorage.removeItem(TOKEN_KEY);
      current = null;
      showAuth();
      toast('已退出，本机保存的 Token 已清除。');
    });

    document.querySelectorAll<HTMLElement>('[data-view]').forEach((button) => {
      button.addEventListener('click', () => {
        currentView = (button.dataset.view as ViewType) || 'posts';
        syncTabs();
      });
    });

    $('new-post').addEventListener('click', () => newItem('posts'));
    $('new-illustration').addEventListener('click', () => newItem('illustrations'));
    $('new-note').addEventListener('click', () => newItem('notes'));
    $('new-project').addEventListener('click', () => newItem('projects'));
    document.querySelectorAll<HTMLElement>('[data-new]').forEach((button) => {
      button.addEventListener('click', () => newItem((button.dataset.new as ItemType) || 'posts'));
    });

    $('refresh-button').addEventListener('click', () => {
      loadData().catch((error) => toast(error instanceof Error ? error.message : String(error), 'error'));
    });

    $('item-list').addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-path]');
      if (!button) return;
      selectByPath(button.dataset.type as ItemType, button.dataset.path ?? '');
    });

    $('content-form').addEventListener('submit', (event) => {
      event.preventDefault();
      save();
    });

    $('delete-button').addEventListener('click', () => removeCurrent());
    $('preview-button').addEventListener('click', togglePreview);
    $('close-preview').addEventListener('click', () => $('preview-panel').classList.add('hidden'));

    $('cover-upload-button').addEventListener('click', () => $<HTMLInputElement>('cover-file').click());
    $('cover-file').addEventListener('change', async (event) => {
      const input = event.target as HTMLInputElement;
      if (input.files) {
        const folder: UploadFolder = current?.type === 'projects' ? 'projects' : 'posts';
        await uploadFiles(input.files, folder, 'cover');
      }
      input.value = '';
    });
    $('cover-clear').addEventListener('click', () => {
      cover = '';
      renderCover();
    });

    $('illustration-upload-button').addEventListener('click', () => $<HTMLInputElement>('illustration-file').click());
    $('illustration-file').addEventListener('change', async (event) => {
      const input = event.target as HTMLInputElement;
      if (input.files) await uploadFiles(input.files, 'illustrations', 'images');
      input.value = '';
    });

    $('illustration-images').addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-remove-image]');
      if (!button) return;
      images.splice(Number(button.dataset.removeImage), 1);
      renderImages();
    });

    $('media-upload-button').addEventListener('click', () => $<HTMLInputElement>('media-file').click());
    $('media-file').addEventListener('change', async (event) => {
      const input = event.target as HTMLInputElement;
      if (input.files) {
        const folder = $<HTMLSelectElement>('media-folder').value as UploadFolder;
        await uploadFiles(input.files, folder, 'media');
      }
      input.value = '';
    });

    $('media-grid').addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-media-action]');
      if (!button) return;
      const path = button.dataset.path ?? '';
      const action = button.dataset.mediaAction;

      if (action === 'copy') {
        copyPath(path);
      } else if (action === 'delete') {
        removeMedia(path);
      } else if (action === 'cover') {
        if (!current || (current.type !== 'posts' && current.type !== 'projects')) {
          toast('先选中一篇文章或项目，再设置封面。', 'error');
          return;
        }
        cover = publicPath(path);
        renderCover();
        currentView = current.type;
        syncTabs();
        toast('已设为封面，记得点“保存修改”。');
      } else if (action === 'avatar') {
        avatar = publicPath(path);
        currentView = 'settings';
        syncTabs();
        renderAvatarPreview();
        toast('已设为头像，记得点“保存设置”。');
      } else if (action === 'insert') {
        if (!current || current.type !== 'illustrations') {
          toast('先选中一幅插画，再加入图片。', 'error');
          return;
        }
        const value = publicPath(path);
        if (!images.includes(value)) images.push(value);
        renderImages();
        currentView = 'illustrations';
        syncTabs();
        toast('已加入插画，记得点“保存修改”。');
      }
    });

    $('settings-avatar').addEventListener('input', (event) => {
      avatar = (event.target as HTMLInputElement).value.trim();
      renderAvatarPreview();
    });
    $('settings-avatar-media').addEventListener('change', (event) => {
      const value = (event.target as HTMLSelectElement).value;
      if (!value) return;
      avatar = value;
      $<HTMLInputElement>('settings-avatar').value = value;
      renderAvatarPreview();
    });
    $('settings-bio').addEventListener('input', (event) => {
      profile.bio = (event.target as HTMLTextAreaElement).value;
    });
    $('avatar-upload-button').addEventListener('click', () => $<HTMLInputElement>('avatar-file').click());
    $('avatar-file').addEventListener('change', async (event) => {
      const input = event.target as HTMLInputElement;
      if (input.files) await uploadFiles(input.files, 'site', 'avatar');
      input.value = '';
    });

    $('settings-categories').addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-remove-category]');
      if (!button) return;
      const row = button.closest<HTMLElement>('[data-category-row]');
      row?.remove();
    });
    $('add-post-category').addEventListener('click', () => addCategory('posts'));
    $('add-illustration-category').addEventListener('click', () => addCategory('illustrations'));
    $('save-settings').addEventListener('click', () => {
      saveSettings().catch((error) => toast(error instanceof Error ? error.message : String(error), 'error'));
    });
  }

  if (!REPO || REPO.includes('your-github-username')) {
    $('auth-status').textContent = '站点还没有配置 GitHub 仓库，请先运行 pnpm setup。';
  } else {
    bindEvents();
    if (token) {
      showApp();
      connect(token, Boolean(localStorage.getItem(TOKEN_KEY))).catch((error) => {
        toast(error instanceof Error ? error.message : String(error), 'error');
        showAuth();
      });
    } else {
      showAuth();
    }
  }
</script>
