---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../components/ThreeColumnLayout.astro';
import { isConfigured, site, withBase } from '../consts';
import {
  ILLUSTRATION_CATEGORIES,
  POST_CATEGORIES,
} from '../data/categories';
import { getSiteData } from '../lib/content';

const data = await getSiteData();
const configured = isConfigured();
const repoUrl = configured
  ? `https://github.com/${site.githubUsername}/${site.repoName}`
  : '';
---

<BaseLayout title="关于" description={`关于 ${site.name} 与这个私人存档。`}>
  <div class="border-b border-white/40 bg-gradient-to-b from-violet-50/60 to-transparent dark:border-white/10 dark:from-violet-400/5">
    <div class="mx-auto max-w-[88rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-violet-400">About</p>
      <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink dark:text-white sm:text-4xl">
        关于这个站点
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
        一个用来存放文字和画的私人角落，不开放搜索引擎收录。
      </p>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    tags={data.tags}
    recent={data.recent}
  >
    <section class="card overflow-hidden">
      <div class="h-28 bg-gradient-to-br from-rose-200 via-rose-100 to-violet-200 dark:from-rose-400/20 dark:via-violet-400/10 dark:to-violet-400/20"></div>
      <div class="-mt-12 px-6 pb-7 sm:px-8">
        <img
          src={withBase(site.avatar)}
          alt={`${site.name} 的头像`}
          class="h-24 w-24 rounded-2xl border-4 border-white object-cover shadow-lg dark:border-[#1b1726]"
          loading="eager"
          decoding="async"
        />
        <h2 class="mt-4 font-display text-2xl font-semibold tracking-tight text-ink dark:text-white">
          {site.name}
        </h2>
        <p class="mt-1 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-rose-400">
          writing &amp; drawing
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
          {site.bio}
        </p>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
          这里没有评论、没有访问统计、也没有“猜你喜欢”。文章和插画按时间归档，分类是抽屉，标签是书签。如果某一段文字或某一张画让你停了一会儿，那这个站点就已经完成了它的事。
        </p>

        <div class="mt-5 flex flex-wrap gap-2">
          {
            repoUrl && (
              <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="chip-muted">
                GitHub 仓库
              </a>
            )
          }
          {site.email && <a href={`mailto:${site.email}`} class="chip-muted">写邮件</a>}
          <a href={withBase('/archive/')} class="chip">按时间浏览</a>
        </div>
      </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-2" aria-label="站点说明">
      <div class="card p-5">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-white">这个站点</h2>
        <ul class="mt-3 space-y-2 text-xs leading-6 text-slate-600 dark:text-slate-300">
          <li class="flex gap-2"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rose-400"></span>Astro 静态构建，GitHub Pages 托管。</li>
          <li class="flex gap-2"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rose-400"></span>Sveltia CMS 管理内容，保存即提交到仓库。</li>
          <li class="flex gap-2"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rose-400"></span>Pagefind 提供构建时站内搜索。</li>
          <li class="flex gap-2"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rose-400"></span>没有第三方追踪、广告或评论系统。</li>
        </ul>
      </div>

      <div class="card p-5">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-white">隐私</h2>
        <p class="mt-3 text-xs leading-6 text-slate-600 dark:text-slate-300">
          全站页面包含 <code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-[0.65rem] dark:bg-white/10">noindex, nofollow</code>
          元标签，并在站点根目录提供禁止抓取的 <code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-[0.65rem] dark:bg-white/10">robots.txt</code>。
        </p>
        <p class="mt-2 text-xs leading-6 text-slate-500 dark:text-slate-400">
          搜索引擎收录需要时间，若曾被抓取，可在搜索引擎站长工具中提交移除。这个站点没有公开分享按钮。
        </p>
      </div>
    </section>

    <section class="card p-5 sm:p-6" aria-labelledby="categories-title">
      <h2 id="categories-title" class="font-display text-lg font-semibold text-ink dark:text-white">分类</h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-rose-400">文章</h3>
          <ul class="mt-2 space-y-1.5">
            {POST_CATEGORIES.map((category) => (
              <li>
                <a href={`${withBase('/posts/')}?category=${category.slug}`} class="flex items-baseline gap-2 text-sm text-slate-600 transition hover:text-rose-600 dark:text-slate-300 dark:hover:text-rose-300">
                  <span class="font-medium">{category.label}</span>
                  <span class="text-[0.65rem] text-slate-400">{category.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-violet-400">插画</h3>
          <ul class="mt-2 space-y-1.5">
            {ILLUSTRATION_CATEGORIES.map((category) => (
              <li>
                <a href={`${withBase('/illustrations/')}?category=${category.slug}`} class="flex items-baseline gap-2 text-sm text-slate-600 transition hover:text-violet-600 dark:text-slate-300 dark:hover:text-violet-300">
                  <span class="font-medium">{category.label}</span>
                  <span class="text-[0.65rem] text-slate-400">{category.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="card p-5 sm:p-6" aria-labelledby="backup-title">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="backup-title" class="font-display text-lg font-semibold text-ink dark:text-white">数据与备份</h2>
          <p class="mt-2 max-w-xl text-xs leading-6 text-slate-600 dark:text-slate-300">
            内容以 Markdown 和图片文件保存在 GitHub 仓库，每一次保存都会产生一条提交记录。站点另有每周自动备份，把仓库打包到 <code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-[0.65rem] dark:bg-white/10">backup</code> 分支。
          </p>
        </div>
        <span class="chip-muted">自动 + 手动</span>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href={withBase('/admin/')} class="chip">打开后台</a>
        {
          repoUrl && (
            <a href={`${repoUrl}/actions`} target="_blank" rel="noopener noreferrer" class="chip-muted">
              查看 Actions
            </a>
          )
        }
        {
          repoUrl && (
            <a href={`${repoUrl}/tree/backup`} target="_blank" rel="noopener noreferrer" class="chip-muted">
              备份分支
            </a>
          )
        }
      </div>
      <p class="mt-3 text-[0.65rem] leading-5 text-slate-400 dark:text-slate-500">
        手动导出与恢复步骤见仓库中的 <code class="font-mono">docs/BACKUP.md</code>。
      </p>
    </section>
  </ThreeColumnLayout>
</BaseLayout>
