---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../../components/ThreeColumnLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { withBase } from '../../consts';
import { getSiteData } from '../../lib/content';

const data = await getSiteData();
const images = data.illustrations.flatMap((illustration) =>
  illustration.data.images.map((src, index) => ({
    src: withBase(src),
    alt: `${illustration.data.title} 第 ${index + 1} 张`,
  })),
);
---

<BaseLayout title="照片墙" description="所有插画放在一面墙上，慢慢看。">
  <div class="border-b border-white/40 bg-gradient-to-b from-violet-50/70 to-transparent dark:border-white/10 dark:from-violet-400/5">
    <div class="mx-auto max-w-[88rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-violet-400">Gallery</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl font-semibold tracking-tight text-ink dark:text-white sm:text-4xl">照片墙</h1>
          <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
            把插画从文章里拿出来，铺成一面墙。点开可以放大看。
          </p>
        </div>
        <p class="rounded-full border border-white/70 bg-white/60 px-3 py-1.5 text-xs text-slate-500 backdrop-blur dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
          共 <span class="font-semibold text-ink dark:text-white">{images.length}</span> 张
        </p>
      </div>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    noteCount={data.noteCount}
    projectCount={data.projectCount}
    recent={data.recent}
  >
    {images.length > 0 ? (
      <Lightbox images={images} title="照片墙" layout="masonry" />
    ) : (
      <div class="card p-10 text-center">
        <p class="font-display text-xl text-ink dark:text-white">墙上还是空的</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          去 <a href={withBase('/editor/')} class="text-rose-500 underline underline-offset-4">/editor</a> 上传第一幅插画。
        </p>
      </div>
    )}

    <div class="flex justify-center pt-2">
      <a href={withBase('/illustrations/')} class="chip-muted">
        按分类浏览插画
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </ThreeColumnLayout>
</BaseLayout>
