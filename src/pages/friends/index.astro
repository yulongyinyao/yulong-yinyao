---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../../components/ThreeColumnLayout.astro';
import { friends } from '../../data/friends';
import { withBase } from '../../consts';
import { getSiteData } from '../../lib/content';

const data = await getSiteData();
---

<BaseLayout title="友链" description="一些常去的地方，和愿意互相留一扇门的人。">
  <div class="border-b border-white/40 bg-gradient-to-b from-emerald-50/60 to-transparent dark:border-white/10 dark:from-emerald-300/5">
    <div class="mx-auto max-w-[88rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-emerald-500">Friends</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl font-semibold tracking-tight text-ink dark:text-white sm:text-4xl">友链</h1>
          <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
            一些常去的地方。比起算法推荐，更愿意相信朋友的门牌。
          </p>
        </div>
        <p class="rounded-full border border-white/70 bg-white/60 px-3 py-1.5 text-xs text-slate-500 backdrop-blur dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
          共 <span class="font-semibold text-ink dark:text-white">{friends.length}</span> 个
        </p>
      </div>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    noteCount={data.noteCount}
    projectCount={data.projectCount}
    recent={data.recent}
  >
    {friends.length > 0 ? (
      <div class="grid gap-4 sm:grid-cols-2">
        {friends.map((friend) => (
          <a
            href={friend.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card group flex items-start gap-4 p-5 transition hover:-translate-y-0.5 hover:shadow-[0_22px_50px_-30px_rgba(100,60,70,0.45)]"
          >
            {friend.avatar ? (
              <img src={friend.avatar} alt="" class="h-12 w-12 rounded-xl object-cover" loading="lazy" />
            ) : (
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-emerald-100 to-amber-100 font-display text-lg text-emerald-700 dark:from-emerald-400/20 dark:to-amber-300/10 dark:text-emerald-200">
                {friend.name.slice(0, 1)}
              </span>
            )}
            <span class="min-w-0">
              <span class="block font-display text-lg font-semibold text-ink transition group-hover:text-rose-600 dark:text-white dark:group-hover:text-rose-300">
                {friend.name}
              </span>
              <span class="mt-1 block text-xs leading-6 text-slate-500 dark:text-slate-400">{friend.description}</span>
            </span>
          </a>
        ))}
      </div>
    ) : (
      <div class="card p-10 text-center">
        <p class="font-display text-xl text-ink dark:text-white">这一页还空着</p>
        <p class="mx-auto mt-2 max-w-md text-sm leading-7 text-slate-500 dark:text-slate-400">
          友链是静态数据，添加时编辑仓库里的
          <code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-[0.7rem] dark:bg-white/10">src/data/friends.ts</code>，
          下一次部署就会出现在这里。
        </p>
        <a href={withBase('/about/')} class="chip mt-5">关于这个站点</a>
      </div>
    )}

    <section class="card p-5 text-center sm:p-6">
      <p class="font-display text-lg text-ink dark:text-white">想交换链接？</p>
      <p class="mx-auto mt-2 max-w-lg text-xs leading-6 text-slate-500 dark:text-slate-400">
        这个站点很小，但愿意认识认真写字、画画的人。可以在 GitHub 仓库开一个 issue，或者写邮件。
      </p>
    </section>
  </ThreeColumnLayout>
</BaseLayout>
