---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../../components/ThreeColumnLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getSiteData } from '../../lib/content';

const data = await getSiteData();
---

<BaseLayout title="项目" description="做过的东西、正在做的事，以及一些没有做完的尝试。">
  <div class="border-b border-white/40 bg-gradient-to-b from-rose-50/70 to-transparent dark:border-white/10 dark:from-rose-400/5">
    <div class="mx-auto max-w-[88rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h1 class="font-display text-3xl font-semibold tracking-tight text-ink dark:text-white sm:text-4xl">项目</h1>
        <p class="rounded-full border border-white/70 bg-white/60 px-3 py-1.5 text-xs text-slate-500 backdrop-blur dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
          共 <span class="font-semibold text-ink dark:text-white">{data.projectCount}</span> 个
        </p>
      </div>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    noteCount={data.noteCount}
    projectCount={data.projectCount}
    recent={data.recent}
  >
    {data.projects.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2">
        {data.projects.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <div class="card p-10 text-center">
        <p class="font-display text-xl text-ink dark:text-white">还没有项目</p>
      </div>
    )}
  </ThreeColumnLayout>
</BaseLayout>
