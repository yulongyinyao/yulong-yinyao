---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../../components/ThreeColumnLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { formatDate, withBase } from '../../consts';
import { getPublishedProjects, getSiteData } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = await getSiteData();
const related = data.projects.filter((item) => item.id !== project.id).slice(0, 2);
const cover = project.data.cover ? withBase(project.data.cover) : '';
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary || `项目：${project.data.title}`}
  image={cover || undefined}
  pagefindIgnore={false}
>
  <div class="border-b border-white/40 bg-gradient-to-b from-rose-50/60 to-transparent dark:border-white/10 dark:from-rose-400/5">
    <div class="mx-auto max-w-[88rem] px-4 py-8 sm:px-6 lg:px-8">
      <nav class="flex flex-wrap items-center gap-2 text-[0.68rem] text-slate-400" aria-label="面包屑">
        <a href={withBase('/')} class="transition hover:text-rose-500">首页</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/projects/')} class="transition hover:text-rose-500">项目</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-500 dark:text-slate-400">{project.data.title}</span>
      </nav>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    noteCount={data.noteCount}
    projectCount={data.projectCount}
    recent={data.recent}
  >
    <article class="card overflow-hidden" data-pagefind-body>
      {cover && (
        <img
          src={cover}
          alt={project.data.title}
          class="max-h-[28rem] w-full object-cover"
          loading="eager"
          decoding="async"
        />
      )}

      <div class="p-6 sm:p-8">
        <div class="flex flex-wrap items-center gap-2 text-[0.68rem] text-slate-400">
          <time datetime={project.data.date}>{formatDate(project.data.date)}</time>
          {project.data.featured && <span class="chip-muted">精选</span>}
        </div>
        <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink dark:text-white sm:text-4xl">
          {project.data.title}
        </h1>
        {project.data.summary && (
          <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">{project.data.summary}</p>
        )}

        <div class="mt-5 flex flex-wrap items-center gap-2">
          {project.data.tags.map((tag) => <span class="chip-muted">#{tag}</span>)}
        </div>

        {(project.data.link || project.data.repo) && (
          <div class="mt-5 flex flex-wrap gap-2">
            {project.data.link && (
              <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="chip">
                访问项目
                <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M14 3h7v7m0-7L10 14M5 5v14h14v-5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            )}
            {project.data.repo && (
              <a href={project.data.repo} target="_blank" rel="noopener noreferrer" class="chip-muted">GitHub 仓库</a>
            )}
          </div>
        )}

        <div class="prose prose-custom mt-8 max-w-none">
          <Content />
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section aria-labelledby="related-projects" class="pt-2">
        <h2 id="related-projects" class="mb-3 px-1 font-display text-lg font-semibold text-ink dark:text-white">其他项目</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {related.map((item) => <ProjectCard project={item} />)}
        </div>
      </section>
    )}

    <div class="flex justify-center pt-2">
      <a href={withBase('/projects/')} class="chip-muted">返回项目列表</a>
    </div>
  </ThreeColumnLayout>
</BaseLayout>
