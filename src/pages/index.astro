---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SearchBar from '../components/SearchBar.astro';
import ThreeColumnLayout from '../components/ThreeColumnLayout.astro';
import CategoryNav from '../components/CategoryNav.astro';
import PostCard from '../components/PostCard.astro';
import IllustrationCard from '../components/IllustrationCard.astro';
import NoteCard from '../components/NoteCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../consts';
import { getSiteData } from '../lib/content';

const data = await getSiteData();
const latestPosts = data.posts.slice(0, 3);
const latestIllustrations = data.illustrations.slice(0, 2);
const latestNotes = await Promise.all(
  data.notes.slice(0, 2).map(async (note) => ({
    note,
    Content: (await render(note)).Content,
  })),
);
const featuredProjects = data.featuredProjects.slice(0, 2);
const galleryImages = data.illustrations
  .flatMap((illustration) => illustration.data.images)
  .slice(0, 4)
  .map((src) => withBase(src));

const groups = [
  {
    label: '文章分类',
    total: data.postCount,
    unit: '篇',
    baseHref: withBase('/posts/'),
    categories: data.postCategories,
  },
  {
    label: '插画分类',
    total: data.illustrationCount,
    unit: '幅',
    baseHref: withBase('/illustrations/'),
    categories: data.illustrationCategories,
  },
];
---

<BaseLayout description="银曜的个人博客：文章与插画。">
  <Hero />
  <SearchBar />

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    noteCount={data.noteCount}
    projectCount={data.projectCount}
    recent={data.recent}
  >
    <CategoryNav groups={groups} />

    <section aria-labelledby="latest-posts">
      <div class="mb-3 flex items-end justify-between gap-3 px-1">
        <div>
          <h2 id="latest-posts" class="font-display text-2xl font-semibold tracking-tight text-ink dark:text-white">
            最近写的
          </h2>
        </div>
        <a href={withBase('/posts/')} class="chip-muted">
          全部文章
          <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      {
        latestPosts.length > 0 ? (
          <div class="grid gap-4">
            {latestPosts.map((post) => <PostCard post={post} />)}
          </div>
        ) : (
          <div class="card p-8 text-center">
            <p class="font-display text-lg text-ink dark:text-white">还没有文章</p>
          </div>
        )
      }
    </section>

    <section aria-labelledby="latest-illustrations">
      <div class="mb-3 flex items-end justify-between gap-3 px-1">
        <div>
          <h2 id="latest-illustrations" class="font-display text-2xl font-semibold tracking-tight text-ink dark:text-white">
            最近画的
          </h2>
        </div>
        <a href={withBase('/illustrations/')} class="chip-muted">
          全部插画
          <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      {
        latestIllustrations.length > 0 ? (
          <div class="grid gap-4 sm:grid-cols-2">
            {latestIllustrations.map((illustration) => (
              <IllustrationCard illustration={illustration} compact />
            ))}
          </div>
        ) : (
          <div class="card p-8 text-center">
            <p class="font-display text-lg text-ink dark:text-white">还没有插画</p>
          </div>
        )
      }
    </section>

    {
      latestNotes.length > 0 && (
        <section aria-labelledby="latest-notes">
          <div class="mb-3 flex items-end justify-between gap-3 px-1">
            <h2
              id="latest-notes"
              class="font-display text-2xl font-semibold tracking-tight text-ink dark:text-white"
            >
              最近记下
            </h2>
            <a href={withBase('/notes/')} class="chip-muted">
              全部说说
              <svg
                viewBox="0 0 24 24"
                class="h-3 w-3"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>

          <div class="grid gap-4">
            {latestNotes.map(({ note, Content }) => (
              <NoteCard note={note}>
                <Content />
              </NoteCard>
            ))}
          </div>
        </section>
      )
    }

    {
      featuredProjects.length > 0 && (
        <section aria-labelledby="featured-projects">
          <div class="mb-3 flex items-end justify-between gap-3 px-1">
            <h2
              id="featured-projects"
              class="font-display text-2xl font-semibold tracking-tight text-ink dark:text-white"
            >
              在做的事
            </h2>
            <a href={withBase('/projects/')} class="chip-muted">
              全部项目
              <svg
                viewBox="0 0 24 24"
                class="h-3 w-3"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {featuredProjects.map((project) => <ProjectCard project={project} />)}
          </div>
        </section>
      )
    }

    {
      galleryImages.length > 0 && (
        <section class="card overflow-hidden" aria-labelledby="gallery-entry">
          <a href={withBase('/gallery/')} class="group grid gap-0 sm:grid-cols-[1fr_1.1fr]">
            <div class="grid grid-cols-2 gap-1.5 bg-gradient-to-br from-rose-100 via-[#f8f4ed] to-violet-100 p-2 dark:from-rose-400/10 dark:via-[#fffef9]/5 dark:to-violet-400/10">
              {galleryImages.map((src, index) => (
                <img
                  src={src}
                  alt=""
                  class:list={[
                    'h-24 w-full rounded-lg object-cover transition duration-500 group-hover:scale-[1.02] sm:h-28',
                    index === 0 && 'col-span-2 h-32 sm:h-36',
                  ]}
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>
            <div class="flex flex-col justify-center p-6">
              <h2 id="gallery-entry" class="font-display text-2xl font-semibold tracking-tight text-ink dark:text-white">
                照片墙
              </h2>
            </div>
          </a>
        </section>
      )
    }
  </ThreeColumnLayout>
</BaseLayout>
