---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../../components/ThreeColumnLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import FilterBar from '../../components/FilterBar.astro';
import IllustrationCard from '../../components/IllustrationCard.astro';
import { withBase } from '../../consts';
import { getSiteData } from '../../lib/content';

const data = await getSiteData();
const tags = data.tags.map((tag) => ({
  ...tag,
  href: `${withBase('/illustrations/')}?tag=${encodeURIComponent(tag.name)}`,
}));
const groups = [
  {
    label: '插画分类',
    total: data.illustrationCount,
    unit: '幅',
    baseHref: withBase('/illustrations/'),
    categories: data.illustrationCategories,
  },
];
---

<BaseLayout title="插画" description="按时间收好的插画：原创、练习、同人与约稿。">
  <div class="border-b border-white/40 bg-gradient-to-b from-violet-50/70 to-transparent dark:border-white/10 dark:from-violet-400/5">
    <div class="mx-auto max-w-[88rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-violet-400">Illustration archive</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl font-semibold tracking-tight text-ink dark:text-white sm:text-4xl">插画</h1>
          <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
            画完的、没画完的、想再画一次的，都放在这里。
          </p>
        </div>
        <p class="rounded-full border border-white/70 bg-white/60 px-3 py-1.5 text-xs text-slate-500 backdrop-blur dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
          共 <span class="font-semibold text-ink dark:text-white">{data.illustrationCount}</span> 幅
        </p>
      </div>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    tags={data.tags}
    recent={data.recent}
  >
    <CategoryNav groups={groups} />
    <FilterBar tags={tags} total={data.illustrationCount} noun="幅" />

    {
      data.illustrations.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2">
          {data.illustrations.map((illustration) => <IllustrationCard illustration={illustration} />)}
        </div>
      ) : null
    }

    <div
      class="card p-10 text-center"
      data-filter-empty
      hidden={data.illustrations.length > 0}
    >
      <p class="font-display text-xl text-ink dark:text-white">这个筛选下还没有插画</p>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">换一个分类或标签，或者清除筛选。</p>
    </div>

    <div class="flex justify-center pt-2">
      <a href={withBase('/archive/')} class="chip-muted">
        查看全部归档
        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </ThreeColumnLayout>
</BaseLayout>
