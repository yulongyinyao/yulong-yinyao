---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../../components/ThreeColumnLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import IllustrationCard from '../../components/IllustrationCard.astro';
import { formatDateLong, illustrationHref, withBase } from '../../consts';
import { categoryLabel } from '../../data/categories';
import {
  getPublishedIllustrations,
  getSiteData,
  type IllustrationEntry,
} from '../../lib/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const illustrations = await getPublishedIllustrations();
  return illustrations.map((illustration) => ({
    params: { slug: illustration.id },
    props: { illustration },
  }));
};

interface Props {
  illustration: IllustrationEntry;
}

const { illustration } = Astro.props;
const data = await getSiteData();

const images = illustration.data.images.map((src, index) => ({
  src: withBase(src),
  alt: `${illustration.data.title} · 第 ${index + 1} 张`,
}));

const index = data.illustrations.findIndex((entry) => entry.id === illustration.id);
const newer = index > 0 ? data.illustrations[index - 1] : undefined;
const older =
  index >= 0 && index < data.illustrations.length - 1
    ? data.illustrations[index + 1]
    : undefined;

const related = data.illustrations
  .filter((entry) => entry.id !== illustration.id)
  .map((entry) => ({
    entry,
    score:
      (entry.data.category === illustration.data.category ? 2 : 0) +
      entry.data.tags.filter((tag) => illustration.data.tags.includes(tag)).length,
  }))
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map((item) => item.entry);
---

<BaseLayout
  title={illustration.data.title}
  description={illustration.data.description || `${categoryLabel('illustration', illustration.data.category)}插画`}
  image={illustration.data.images[0]}
  pagefindIgnore={false}
>
  <div class="border-b border-white/40 bg-gradient-to-b from-violet-50/60 to-transparent dark:border-white/10 dark:from-violet-400/5">
    <div class="mx-auto max-w-[88rem] px-4 py-5 sm:px-6 lg:px-8">
      <nav class="flex flex-wrap items-center gap-1.5 text-[0.68rem] text-slate-400 dark:text-slate-500" aria-label="面包屑">
        <a href={withBase('/')} class="transition hover:text-violet-500">首页</a>
        <span>/</span>
        <a href={withBase('/illustrations/')} class="transition hover:text-violet-500">插画</a>
        <span>/</span>
        <span class="truncate text-slate-500 dark:text-slate-400">{illustration.data.title}</span>
      </nav>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    tags={data.tags}
    recent={data.recent}
  >
    <article class="card overflow-hidden" data-pagefind-body>
      <header class="px-5 pb-4 pt-7 sm:px-8 sm:pt-8">
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={`${withBase('/illustrations/')}?category=${encodeURIComponent(illustration.data.category)}`}
            class="chip border-violet-200/70 bg-violet-50/70 text-violet-700 dark:border-violet-300/20 dark:bg-violet-400/10 dark:text-violet-200"
            data-pagefind-filter="category"
            data-pagefind-meta="category"
          >
            {categoryLabel('illustration', illustration.data.category)}
          </a>
          <span class="sr-only" data-pagefind-meta="type">插画</span>
        </div>

        <h1
          class="mt-3 text-balance font-display text-3xl font-semibold leading-tight tracking-tight text-ink dark:text-white sm:text-4xl"
          data-pagefind-meta="title"
        >
          {illustration.data.title}
        </h1>

        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-slate-500 dark:text-slate-400">
          <time datetime={illustration.data.date} data-pagefind-meta="date">
            {formatDateLong(illustration.data.date)}
          </time>
          <span class="h-0.5 w-0.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
          <span>{images.length} 张图</span>
        </div>

        {
          illustration.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5" data-pagefind-ignore>
              {illustration.data.tags.map((tag) => (
                <a
                  href={`${withBase('/illustrations/')}?tag=${encodeURIComponent(tag)}`}
                  class="chip border-violet-200/70 bg-violet-50/70 text-violet-700 dark:border-violet-300/20 dark:bg-violet-400/10 dark:text-violet-200"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }

        {
          illustration.data.description && (
            <p class="mt-5 max-w-2xl whitespace-pre-line text-sm leading-7 text-slate-600 dark:text-slate-300">
              {illustration.data.description}
            </p>
          )
        }
      </header>

      <div class="px-4 pb-6 sm:px-6">
        <Lightbox images={images} title={illustration.data.title} />
      </div>
    </article>

    {
      (newer || older) && (
        <nav class="grid gap-3 sm:grid-cols-2" aria-label="上一幅与下一幅">
          {newer && (
            <a href={illustrationHref(newer.id)} class="card group p-4 transition hover:-translate-y-0.5">
              <p class="text-[0.62rem] uppercase tracking-[0.18em] text-slate-400">更新的</p>
              <p class="mt-1 line-clamp-2 font-display text-sm font-semibold text-ink transition group-hover:text-violet-600 dark:text-white dark:group-hover:text-violet-300">
                {newer.data.title}
              </p>
            </a>
          )}
          {older && (
            <a href={illustrationHref(older.id)} class="card group p-4 text-right transition hover:-translate-y-0.5 sm:col-start-2">
              <p class="text-[0.62rem] uppercase tracking-[0.18em] text-slate-400">更早的</p>
              <p class="mt-1 line-clamp-2 font-display text-sm font-semibold text-ink transition group-hover:text-violet-600 dark:text-white dark:group-hover:text-violet-300">
                {older.data.title}
              </p>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section aria-labelledby="related-illustrations" data-pagefind-ignore>
          <div class="mb-3 flex items-end justify-between px-1">
            <h2 id="related-illustrations" class="font-display text-xl font-semibold text-ink dark:text-white">
              也许还想看
            </h2>
            <span class="text-[0.65rem] text-slate-400">同分类或同标签</span>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {related.map((entry) => <IllustrationCard illustration={entry} compact />)}
          </div>
        </section>
      )
    }
  </ThreeColumnLayout>
</BaseLayout>
