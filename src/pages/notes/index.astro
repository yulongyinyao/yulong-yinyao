---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../../components/ThreeColumnLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { withBase } from '../../consts';
import { getSiteData } from '../../lib/content';

const data = await getSiteData();
const notes = await Promise.all(
  data.notes.map(async (note) => ({
    note,
    Content: (await render(note)).Content,
  })),
);
---

<BaseLayout title="说说" description="短一点的日常、光线和碎片。" pagefindIgnore={false}>
  <div class="border-b border-white/40 bg-gradient-to-b from-amber-50/70 to-transparent dark:border-white/10 dark:from-amber-300/5">
    <div class="mx-auto max-w-[88rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-amber-500">Notes</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="font-display text-3xl font-semibold tracking-tight text-ink dark:text-white sm:text-4xl">说说</h1>
          <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-600 dark:text-slate-300">
            没有写成文章的那些片刻。一两句话，也算数。
          </p>
        </div>
        <p class="rounded-full border border-white/70 bg-white/60 px-3 py-1.5 text-xs text-slate-500 backdrop-blur dark:border-white/10 dark:bg-white/5 dark:text-slate-400">
          共 <span class="font-semibold text-ink dark:text-white">{data.noteCount}</span> 条
        </p>
      </div>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    noteCount={data.noteCount}
    projectCount={data.projectCount}
    recent={data.recent}
  >
    {notes.length > 0 ? (
      <div class="grid gap-4" data-pagefind-body>
        {notes.map(({ note, Content }) => (
          <NoteCard note={note}>
            <Content />
          </NoteCard>
        ))}
      </div>
    ) : (
      <div class="card p-10 text-center">
        <p class="font-display text-xl text-ink dark:text-white">还没有说说</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          打开 <a href={withBase('/editor/')} class="text-rose-500 underline underline-offset-4">/editor</a> 记下第一条。
        </p>
      </div>
    )}
  </ThreeColumnLayout>
</BaseLayout>
