---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThreeColumnLayout from '../../components/ThreeColumnLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDateLong, postHref, readingTime, withBase } from '../../consts';
import { categoryLabel } from '../../data/categories';
import { getPublishedPosts, getSiteData, type PostEntry } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const data = await getSiteData();
const bodyHtml = renderMarkdown(post.body ?? '');
const minutes = readingTime(post.body ?? '');
const cover = post.data.cover ? withBase(post.data.cover) : '';

const index = data.posts.findIndex((entry) => entry.id === post.id);
const newer = index > 0 ? data.posts[index - 1] : undefined;
const older = index >= 0 && index < data.posts.length - 1 ? data.posts[index + 1] : undefined;

const related = data.posts
  .filter((entry) => entry.id !== post.id)
  .map((entry) => ({
    entry,
    score:
      (entry.data.category === post.data.category ? 2 : 0) +
      entry.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
  }))
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map((item) => item.entry);
---

<BaseLayout
  title={post.data.title}
  description={`${categoryLabel('post', post.data.category)} · ${post.data.tags.join('、')}`}
  image={post.data.cover ?? undefined}
  pagefindIgnore={false}
>
  <div class="border-b border-white/40 bg-gradient-to-b from-rose-50/60 to-transparent dark:border-white/10 dark:from-rose-400/5">
    <div class="mx-auto max-w-[88rem] px-4 py-5 sm:px-6 lg:px-8">
      <nav class="flex flex-wrap items-center gap-1.5 text-[0.68rem] text-slate-400 dark:text-slate-500" aria-label="面包屑">
        <a href={withBase('/')} class="transition hover:text-rose-500">首页</a>
        <span>/</span>
        <a href={withBase('/posts/')} class="transition hover:text-rose-500">文章</a>
        <span>/</span>
        <span class="truncate text-slate-500 dark:text-slate-400">{post.data.title}</span>
      </nav>
    </div>
  </div>

  <ThreeColumnLayout
    postCount={data.postCount}
    illustrationCount={data.illustrationCount}
    categoryCount={data.categoryCount}
    tagCount={data.tagCount}
    recent={data.recent}
  >
    <article class="card overflow-hidden" data-pagefind-body>
      <header class="relative">
        {
          cover && (
            <div class="relative aspect-[16/8] overflow-hidden bg-gradient-to-br from-rose-100 to-violet-100 dark:from-rose-400/10 dark:to-violet-400/10">
              <img src={cover} alt="" class="h-full w-full object-cover" loading="eager" decoding="async" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/25 to-transparent"></div>
            </div>
          )
        }

        <div class:list={['px-5 sm:px-8', cover ? 'relative -mt-14' : 'pt-8']}>
          <div class="card-soft p-5 sm:p-6">
            <div class="flex flex-wrap items-center gap-2">
              <a
                href={`${withBase('/posts/')}?category=${encodeURIComponent(post.data.category)}`}
                class="chip"
                data-pagefind-filter="category"
                data-pagefind-meta="category"
              >
                {categoryLabel('post', post.data.category)}
              </a>
              <span class="sr-only" data-pagefind-meta="type">文章</span>
            </div>

            <h1
              class="mt-3 text-balance font-display text-3xl font-semibold leading-tight tracking-tight text-ink dark:text-white sm:text-4xl"
              data-pagefind-meta="title"
            >
              {post.data.title}
            </h1>

            <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-slate-500 dark:text-slate-400">
              <time datetime={post.data.date} data-pagefind-meta="date">{formatDateLong(post.data.date)}</time>
              <span class="h-0.5 w-0.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
              <span>{minutes} 分钟阅读</span>
            </div>

            {
              post.data.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5" data-pagefind-ignore>
                  {post.data.tags.map((tag) => (
                    <a
                      href={`${withBase('/posts/')}?tag=${encodeURIComponent(tag)}`}
                      class="chip-muted"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </header>

      <div class="px-5 pb-8 pt-6 sm:px-8 sm:pt-8">
        <div class="prose prose-custom" set:html={bodyHtml}></div>

        <div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200/70 pt-5 text-xs dark:border-white/10">
          <a href={withBase('/posts/')} class="chip-muted">
            <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m15 5-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            返回文章列表
          </a>
        </div>
      </div>
    </article>

    {
      (newer || older) && (
        <nav class="grid gap-3 sm:grid-cols-2" aria-label="上一篇与下一篇">
          {newer && (
            <a href={postHref(newer.id)} class="card group p-4 transition hover:-translate-y-0.5">
              <p class="text-xs text-slate-400">更新的</p>
              <p class="mt-1 line-clamp-2 font-display text-sm font-semibold text-ink transition group-hover:text-rose-600 dark:text-white dark:group-hover:text-rose-300">
                {newer.data.title}
              </p>
            </a>
          )}
          {older && (
            <a href={postHref(older.id)} class="card group p-4 text-right transition hover:-translate-y-0.5 sm:col-start-2">
              <p class="text-xs text-slate-400">更早的</p>
              <p class="mt-1 line-clamp-2 font-display text-sm font-semibold text-ink transition group-hover:text-rose-600 dark:text-white dark:group-hover:text-rose-300">
                {older.data.title}
              </p>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section aria-labelledby="related-posts" data-pagefind-ignore>
          <div class="mb-3 flex items-end justify-between px-1">
            <h2 id="related-posts" class="font-display text-xl font-semibold text-ink dark:text-white">也许还想读</h2>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {related.map((entry) => <PostCard post={entry} compact />)}
          </div>
        </section>
      )
    }
  </ThreeColumnLayout>
</BaseLayout>
